# ---------------------------------------------------------------------------
# Banco — Neon (integração Vercel -> Storage -> Neon injeta automaticamente)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Conexão SEM pooler. O prisma migrate precisa dela.
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Crons (a Vercel envia este valor como Bearer token)
# ---------------------------------------------------------------------------
CRON_SECRET="troque-por-um-valor-aleatorio"

# ---------------------------------------------------------------------------
# Salt da pseudonimização dos respondentes da Camada 2.
#
# ATENÇÃO: trocar este valor desvincula todas as respostas já gravadas dos
# seus autores — o histórico em /my-work deixa de aparecer para eles.
# Defina uma vez e não mexa mais.
# ---------------------------------------------------------------------------
RESPONDENT_SALT="troque-por-um-valor-aleatorio"

# ---------------------------------------------------------------------------
# Autodesk Construction Cloud (opcional — Camada 1 automatizada)
#
# Registre um app em https://aps.autodesk.com/myapps/create
# O Client ID precisa ser provisionado na conta ACC por um Account Admin.
# A Data Connector API só aceita token 3-legged: um humano autoriza no
# navegador e o refresh token (15 dias) mantém o cron vivo.
# ---------------------------------------------------------------------------
# APS_CLIENT_ID=""
# APS_CLIENT_SECRET=""
# APS_CALLBACK_URL="http://localhost:3000/api/acc/callback"
# URL pública da app, usada nos redirects pós-autorização.
# APP_URL="http://localhost:3000"
# Chave de cifragem dos tokens do ACC em repouso.
# Gere com: openssl rand -base64 32
# ACC_TOKEN_KEY=""

# ---------------------------------------------------------------------------
# Autenticação
#
# Não há dependência externa: login próprio com scrypt e sessão em banco.
# O seed cria admin@datapulse.local com senha provisória "datapulse2026",
# obrigatória de trocar no primeiro acesso. Não use o seed em produção.
# ---------------------------------------------------------------------------
