@@ -0,0 +1,30 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { validateReturn, canDecideOnRevision, validateCommentFile } from "../lib/review-return.ts";
+
+test("comentar exige PDF ou texto", () => {
+  assert.equal(validateReturn({ decision: "COMMENT" }).ok, false);
+  assert.equal(validateReturn({ decision: "COMMENT", text: "  " }).ok, false);
+  assert.equal(validateReturn({ decision: "COMMENT", text: "ver folha 3" }).ok, true);
+  assert.equal(validateReturn({ decision: "COMMENT", hasFile: true }).ok, true);
+});
+
+test("aprovar não exige nada; cancelar exige motivo", () => {
+  assert.equal(validateReturn({ decision: "APPROVE" }).ok, true);
+  assert.equal(validateReturn({ decision: "CANCEL" }).ok, false);
+  assert.equal(validateReturn({ decision: "CANCEL", text: "duplicado" }).ok, true);
+});
+
+test("projetista não aprova o próprio trabalho", () => {
+  assert.equal(canDecideOnRevision({ id: "u1" }, "u1"), false);
+  assert.equal(canDecideOnRevision({ id: "u2" }, "u1"), true);
+  assert.equal(canDecideOnRevision({ id: "u2" }, null), true);
+});
+
+test("limites do PDF comentado", () => {
+  const ok = { contentType: "application/pdf", sizeBytes: 1000, existingCount: 0 };
+  assert.equal(validateCommentFile(ok).ok, true);
+  assert.equal(validateCommentFile({ ...ok, contentType: "image/png" }).ok, false);
+  assert.equal(validateCommentFile({ ...ok, sizeBytes: 26 * 1024 * 1024 }).ok, false);
+  assert.equal(validateCommentFile({ ...ok, existingCount: 5 }).ok, false);
+});
