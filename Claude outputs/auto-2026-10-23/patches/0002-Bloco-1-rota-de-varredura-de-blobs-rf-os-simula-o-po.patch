+++ b/app/api/cron/blob-orphans/route.ts
@@ -0,0 +1,49 @@
+import { NextResponse } from "next/server";
+import { list, del } from "@vercel/blob";
+import { prisma } from "@/lib/prisma";
+import { isCronAuthorized } from "@/lib/cron-auth";
+import { findOrphanBlobs } from "@/lib/blob-orphans";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 120;
+
+/**
+ * Limpeza de blobs órfãos (upload concluído, registro não feito).
+ *
+ * SIMULAÇÃO por padrão: só lista. Para apagar de fato: `?apply=1`.
+ * Não está agendada em vercel.json — rode à mão (ou agende depois de conferir
+ * o resultado da simulação). Mesma autorização dos outros crons.
+ */
+export async function GET(request: Request) {
+  if (!isCronAuthorized(process.env.CRON_SECRET, request.headers.get("authorization"))) {
+    return NextResponse.json({ error: "Não autorizado" }, { status: 401 });
+  }
+  const apply = new URL(request.url).searchParams.get("apply") === "1";
+
+  try {
+    const blobs: { pathname: string; uploadedAt: Date }[] = [];
+    let cursor: string | undefined;
+    do {
+      const page = await list({ prefix: "projetos/", cursor, limit: 1000 });
+      for (const b of page.blobs) blobs.push({ pathname: b.pathname, uploadedAt: b.uploadedAt });
+      cursor = page.hasMore ? page.cursor : undefined;
+    } while (cursor);
+
+    const registered = new Set(
+      (await prisma.projectFile.findMany({ select: { pathname: true } })).map((f) => f.pathname),
+    );
+    const orphans = findOrphanBlobs(blobs, registered, new Date());
+
+    if (apply && orphans.length > 0) await del(orphans.map((o) => o.pathname));
+
+    return NextResponse.json({
+      ok: true,
+      applied: apply,
+      scanned: blobs.length,
+      orphans: orphans.map((o) => o.pathname),
+    });
+  } catch (error) {
+    console.error("[cron/blob-orphans] falha", error);
+    return NextResponse.json({ ok: false, error: "Falha na varredura de blobs" }, { status: 500 });
+  }
+}
diff --git a/lib/blob-orphans.ts b/lib/blob-orphans.ts
new file mode 100644
index 0000000..efc76be
--- /dev/null
+++ b/lib/blob-orphans.ts
@@ -0,0 +1,24 @@
+/**
+ * Detecta blobs órfãos: arquivo enviado ao Blob cujo registro (`ProjectFile`)
+ * nunca foi gravado (aba fechada no meio do envio). Módulo puro.
+ *
+ * Só são candidatos blobs mais antigos que `minAgeMs` — um envio em andamento
+ * ainda não tem registro e não pode ser apagado.
+ */
+export type BlobEntry = { pathname: string; uploadedAt: Date };
+
+export const ORPHAN_MIN_AGE_MS = 24 * 60 * 60 * 1000;
+
+export function findOrphanBlobs(
+  blobs: ReadonlyArray<BlobEntry>,
+  registeredPathnames: ReadonlySet<string>,
+  now: Date,
+  minAgeMs: number = ORPHAN_MIN_AGE_MS,
+): BlobEntry[] {
+  return blobs.filter(
+    (b) =>
+      b.pathname.startsWith("projetos/") &&
+      !registeredPathnames.has(b.pathname) &&
+      now.getTime() - b.uploadedAt.getTime() >= minAgeMs,
+  );
+}
diff --git a/test/blob-orphans.test.mjs b/test/blob-orphans.test.mjs
new file mode 100644
index 0000000..b9056aa
--- /dev/null
+++ b/test/blob-orphans.test.mjs
@@ -0,0 +1,20 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { findOrphanBlobs } from "../lib/blob-orphans.ts";
+
+test("só apaga o que não tem registro, é do prefixo e é antigo", () => {
+  const now = new Date("2026-10-23T12:00:00Z");
+  const old = new Date("2026-10-20T12:00:00Z");
+  const fresh = new Date("2026-10-23T11:00:00Z");
+  const out = findOrphanBlobs(
+    [
+      { pathname: "projetos/p1/a.pdf", uploadedAt: old },
+      { pathname: "projetos/p1/b.pdf", uploadedAt: old },
+      { pathname: "projetos/p1/c.pdf", uploadedAt: fresh },
+      { pathname: "outro/x.pdf", uploadedAt: old },
+    ],
+    new Set(["projetos/p1/a.pdf"]),
+    now,
+  );
+  assert.deepEqual(out.map((b) => b.pathname), ["projetos/p1/b.pdf"]);
+});
