+ * Só vale para documentos que já têm tarefa própria; o status e o início real
+ * da tarefa são recalculados a partir daí.
+ */
+export async function updateDocumentProgress(formData: FormData): Promise<void> {
+  const user = await requireWriter();
+
+  const documentId = str(formData, "documentId");
+  const raw = Number(str(formData, "progress"));
+  if (!documentId || !Number.isFinite(raw)) return;
+
+  const doc = await prisma.document.findFirst({
+    where: { id: documentId, project: { organizationId: user.organizationId } },
+    select: {
+      id: true,
+      projectId: true,
+      taskId: true,
+      responsibleId: true,
+      project: { select: { status: true } },
+    },
+  });
+  if (!doc || !doc.taskId) return;
+  if (!isProjectWritable(doc.project.status)) return;
+  if (!(await canSeeProject(user, doc.projectId))) return;
+  // ADMIN/MANAGER ou o próprio responsável pelo documento.
+  if (!canManageProjects(user) && doc.responsibleId !== user.id) return;
+
+  await prisma.document.update({
+    where: { id: doc.id },
+    data: { declaredProgress: capDeclaredProgress(raw, false) },
+  });
