+/**
+ * Componente de ritmo. Só existe com início previsto e prazo válidos (prazo
+ * depois do início). Antes do início, nada é esperado; depois do prazo, 100%
+ * era esperado (o atraso em si já é contado em `scheduleSlip`).
+ */
+export function computePaceComponent(pace: PaceInput | undefined, now: Date): Component | null {
+  if (!pace || !pace.startDate || !pace.dueDate) return null;
+  const span = pace.dueDate.getTime() - pace.startDate.getTime();
+  if (span <= 0) return null;
+  const expected = clamp(((now.getTime() - pace.startDate.getTime()) / span) * 100);
+  const gap = Math.max(0, expected - clamp(pace.progress));
+  return {
+    value: clamp((gap / DRI_CONFIG.paceGapCap) * 100),
+    weight: DRI_CONFIG.paceWeight,
+  };
+}
