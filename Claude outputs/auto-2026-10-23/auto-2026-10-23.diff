diff --git a/lib/a1.ts b/lib/a1.ts
new file mode 100644
index 0000000..b0d0b70
--- /dev/null
+++ b/lib/a1.ts
@@ -0,0 +1,103 @@
+/**
+ * A1 equivalente — a unidade de peso e de preço dos documentos (decisão de
+ * 15/10/2026). O tamanho do documento (formato × folhas) vira "folhas de A1":
+ * A1 = 1, A2 = 0,5, A3 = 0,25, A4 = 0,125. A tabela é configurável por
+ * projetista (um formato novo, como A0 = 2, entra sem mexer no código).
+ *
+ * Mede TAMANHO, não esforço: o valor em reais é A1 equivalente × valor do A1
+ * acertado com o contratante. Módulo puro, testado em `test/a1.test.mjs`.
+ */
+export type A1Factors = Record<string, number>;
+
+export const DEFAULT_A1_FACTORS: Readonly<A1Factors> = Object.freeze({
+  A1: 1,
+  A2: 0.5,
+  A3: 0.25,
+  A4: 0.125,
+});
+
+/** Casas decimais do A1 equivalente (0,125 exige pelo menos 3). */
+export const A1_DECIMALS = 3;
+
+export function roundTo(value: number, decimals: number): number {
+  const f = 10 ** decimals;
+  return Math.round((value + Number.EPSILON) * f) / f;
+}
+
+/** "a3 " -> "A3". Vazio -> null. */
+export function normalizeFormat(value: unknown): string | null {
+  const s = String(value ?? "").trim().toUpperCase();
+  return s.length > 0 ? s : null;
+}
+
+/**
+ * Lê a tabela de fatores guardada (JSON). Entradas inválidas (fator <= 0 ou
+ * não numérico) são descartadas; tabela vazia ou ausente cai no padrão.
+ */
+export function parseA1Factors(input: unknown): A1Factors {
+  if (!input || typeof input !== "object" || Array.isArray(input)) return { ...DEFAULT_A1_FACTORS };
+  const out: A1Factors = {};
+  for (const [k, v] of Object.entries(input as Record<string, unknown>)) {
+    const key = normalizeFormat(k);
+    const n = typeof v === "number" ? v : Number(String(v).replace(",", "."));
+    if (key && Number.isFinite(n) && n > 0) out[key] = n;
+  }
+  return Object.keys(out).length > 0 ? out : { ...DEFAULT_A1_FACTORS };
+}
+
+/**
+ * A1 equivalente de um documento: folhas × fator do formato. Devolve null se o
+ * formato não está na tabela ou as folhas não são um inteiro positivo.
+ */
+export function a1Equivalent(
+  format: unknown,
+  sheets: unknown,
+  factors: A1Factors = DEFAULT_A1_FACTORS,
+): number | null {
+  const key = normalizeFormat(format);
+  const n = typeof sheets === "number" ? sheets : Number(sheets);
+  if (!key || !Number.isInteger(n) || n < 1) return null;
+  const factor = factors[key];
+  if (factor === undefined) return null;
+  return roundTo(n * factor, A1_DECIMALS);
+}
+
+/** Valor em reais de um peso em A1 equivalente. Sem valor do A1 válido, null. */
+export function a1Value(a1eq: number | null | undefined, a1UnitValue: number | null | undefined): number | null {
+  if (a1eq == null || a1UnitValue == null || !Number.isFinite(a1UnitValue) || a1UnitValue <= 0) return null;
+  return roundTo(a1eq * a1UnitValue, 2);
+}
+
+/**
+ * Peso (em A1 equivalente) de uma atividade que não é documento: o valor
+ * estimado (horas × custo-hora) dividido pelo valor do A1.
+ */
+export function activityWeight(
+  estimatedValue: number | null | undefined,
+  a1UnitValue: number | null | undefined,
+): number | null {
+  if (estimatedValue == null || !Number.isFinite(estimatedValue) || estimatedValue < 0) return null;
+  if (a1UnitValue == null || !Number.isFinite(a1UnitValue) || a1UnitValue <= 0) return null;
+  return roundTo(estimatedValue / a1UnitValue, A1_DECIMALS);
+}
+
+/** Estimativa de uma atividade: horas × custo-hora. */
+export function activityEstimate(hours: number, hourlyCost: number): number | null {
+  if (!Number.isFinite(hours) || !Number.isFinite(hourlyCost) || hours < 0 || hourlyCost < 0) return null;
+  return roundTo(hours * hourlyCost, 2);
+}
+
+/**
+ * Impacto econômico automático de uma tarefa (unidade única: reais). O valor
+ * digitado vence; senão, documento = A1 equivalente × valor do A1 do
+ * contratante. Sem nenhum dos dois, nulo (a tarefa não entra no termo
+ * econômico do DRI do projeto).
+ */
+export function taskEconomicImpact(input: {
+  explicit?: number | null;
+  a1Equivalent?: number | null;
+  a1UnitValue?: number | null;
+}): number | null {
+  if (input.explicit != null && Number.isFinite(input.explicit)) return input.explicit;
+  return a1Value(input.a1Equivalent ?? null, input.a1UnitValue ?? null);
+}
