diff --git a/app/api/cron/blob-orphans/route.ts b/app/api/cron/blob-orphans/route.ts
new file mode 100644
index 0000000..5261049
--- /dev/null
+++ b/app/api/cron/blob-orphans/route.ts
@@ -0,0 +1,49 @@
+import { NextResponse } from "next/server";
+import { list, del } from "@vercel/blob";
+import { prisma } from "@/lib/prisma";
+import { isCronAuthorized } from "@/lib/cron-auth";
+import { findOrphanBlobs } from "@/lib/blob-orphans";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 120;
+
+/**
+ * Limpeza de blobs órfãos (upload concluído, registro não feito).
+ *
+ * SIMULAÇÃO por padrão: só lista. Para apagar de fato: `?apply=1`.
+ * Não está agendada em vercel.json — rode à mão (ou agende depois de conferir
+ * o resultado da simulação). Mesma autorização dos outros crons.
+ */
+export async function GET(request: Request) {
+  if (!isCronAuthorized(process.env.CRON_SECRET, request.headers.get("authorization"))) {
+    return NextResponse.json({ error: "Não autorizado" }, { status: 401 });
+  }
+  const apply = new URL(request.url).searchParams.get("apply") === "1";
+
+  try {
+    const blobs: { pathname: string; uploadedAt: Date }[] = [];
+    let cursor: string | undefined;
+    do {
+      const page = await list({ prefix: "projetos/", cursor, limit: 1000 });
+      for (const b of page.blobs) blobs.push({ pathname: b.pathname, uploadedAt: b.uploadedAt });
+      cursor = page.hasMore ? page.cursor : undefined;
+    } while (cursor);
+
+    const registered = new Set(
+      (await prisma.projectFile.findMany({ select: { pathname: true } })).map((f) => f.pathname),
+    );
+    const orphans = findOrphanBlobs(blobs, registered, new Date());
+
+    if (apply && orphans.length > 0) await del(orphans.map((o) => o.pathname));
+
+    return NextResponse.json({
+      ok: true,
+      applied: apply,
+      scanned: blobs.length,
+      orphans: orphans.map((o) => o.pathname),
+    });
+  } catch (error) {
+    console.error("[cron/blob-orphans] falha", error);
+    return NextResponse.json({ ok: false, error: "Falha na varredura de blobs" }, { status: 500 });
+  }
+}
