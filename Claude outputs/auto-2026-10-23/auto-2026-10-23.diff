+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  capDeclaredProgress, stageForProgress, projectDocumentTask, shouldStampActualStart, twoClocks,
+} from "../lib/document-task.ts";
+
+const d = (s) => new Date(s + "T00:00:00.000Z");
+
+test("100% só com PDF enviado", () => {
+  assert.equal(capDeclaredProgress(100, false), 99);
+  assert.equal(capDeclaredProgress(100, true), 100);
+  assert.equal(capDeclaredProgress(-5, true), 0);
+  assert.equal(capDeclaredProgress(NaN, true), 0);
+  assert.equal(stageForProgress(50, false).key, "ELABORATING");
+  assert.equal(stageForProgress(80, false).key, "INTERNAL_CHECK");
+  assert.equal(stageForProgress(95, false).key, "READY_TO_ISSUE");
+  assert.equal(stageForProgress(100, true).key, "ISSUED");
+});
+
+test("sem revisão ou rascunho: A fazer / Em andamento, nunca 100%", () => {
+  assert.deepEqual(
+    (({ status, progress }) => ({ status, progress }))(projectDocumentTask({ current: null, declaredProgress: 0 })),
+    { status: "NOT_STARTED", progress: 0 },
+  );
+  const p = projectDocumentTask({ current: { status: "DRAFT", dueAt: null, analyzedAt: null }, declaredProgress: 100 });
+  assert.equal(p.status, "IN_PROGRESS");
+  assert.equal(p.progress, 99);
+  assert.equal(p.ball, "DESIGNER");
+});
+
+test("em análise: Em revisão, 100%, bola com o contratante, prazo = dueAt", () => {
+  const p = projectDocumentTask({
+    current: { status: "IN_REVIEW", dueAt: d("2026-11-01"), analyzedAt: null },
+    declaredProgress: 30,
+  });
+  assert.equal(p.status, "IN_REVIEW");
+  assert.equal(p.progress, 100);
+  assert.equal(p.ball, "CLIENT");
+  assert.equal(p.forecastDate.toISOString().slice(0, 10), "2026-11-01");
+});
+
+test("comentada volta para a projetista (máx. 99%); aprovada fecha com data da aprovação", () => {
+  const c = projectDocumentTask({
+    current: { status: "COMMENTED", dueAt: null, analyzedAt: d("2026-10-10") },
+    declaredProgress: 100,
+  });
+  assert.equal(c.status, "IN_PROGRESS");
+  assert.equal(c.progress, 99);
+  const a = projectDocumentTask({
+    current: { status: "APPROVED", dueAt: null, analyzedAt: d("2026-10-12") },
+    declaredProgress: 10,
+  });
+  assert.equal(a.status, "DONE");
+  assert.equal(a.progress, 100);
+  assert.equal(a.actualDate.toISOString().slice(0, 10), "2026-10-12");
+});
+
+test("cancelado sai; impedimento bloqueia só o que está aberto", () => {
+  assert.equal(
+    projectDocumentTask({ current: { status: "CANCELLED", dueAt: null, analyzedAt: null }, declaredProgress: 50, blocked: true }).status,
+    "CANCELLED",
+  );
+  assert.equal(
+    projectDocumentTask({ current: { status: "APPROVED", dueAt: null, analyzedAt: d("2026-10-12") }, declaredProgress: 0, blocked: true }).status,
+    "DONE",
+  );
+  assert.equal(projectDocumentTask({ current: null, declaredProgress: 20, blocked: true }).status, "BLOCKED");
+});
+
+test("início real: primeira vez que o avanço sai de 0%", () => {
+  assert.equal(shouldStampActualStart(0, 10, null), true);
+  assert.equal(shouldStampActualStart(10, 20, null), false);
+  assert.equal(shouldStampActualStart(0, 10, d("2026-10-01")), false);
+  assert.equal(shouldStampActualStart(0, 0, null), false);
+});
+
+test("dois relógios: análise lenta do contratante não pesa para a projetista", () => {
+  const clocks = twoClocks(
+    [
+      { issuedAt: d("2026-10-11"), analyzedAt: d("2026-10-21") }, // 10 dias com ele
+      { issuedAt: d("2026-10-26"), analyzedAt: null }, // devolvido em 21 → 5 dias com ela; em aberto até 30 → 4 dias com ele
+    ],
+    d("2026-10-01"), // 10 dias com ela no primeiro ciclo
+    d("2026-10-30"),
+  );
+  assert.deepEqual(clocks, { designerDays: 15, clientDays: 14 });
+});
