+import test from "node:test";
+import assert from "node:assert/strict";
+import { clientProgress, clientDueDate } from "../lib/client-progress.ts";
+
+test("média ponderada pelo A1 equivalente, não simples", () => {
+  const r = clientProgress([
+    { weight: 10, progress: 100, status: "DONE", approved: true },
+    { weight: 0.125, progress: 0, status: "NOT_STARTED", approved: false },
+  ]);
+  // simples seria 50%; ponderada ≈ 98,8%
+  assert.equal(r.elaboration, 98.8);
+  assert.equal(r.approved, 98.8);
+});
+
+test("elaboração e aprovado são números diferentes", () => {
+  const r = clientProgress([
+    { weight: 1, progress: 100, status: "IN_REVIEW", approved: false },
+    { weight: 1, progress: 100, status: "DONE", approved: true },
+  ]);
+  assert.equal(r.elaboration, 100);
+  assert.equal(r.approved, 50);
+});
+
+test("cancelado sai; fora de escopo sai e é contado; vazio é null", () => {
+  const r = clientProgress([
+    { weight: 1, progress: 50, status: "IN_PROGRESS", approved: false },
+    { weight: 5, progress: 0, status: "CANCELLED", approved: false },
+    { weight: 5, progress: 0, status: "NOT_STARTED", approved: false, inScope: false },
+  ]);
+  assert.equal(r.elaboration, 50);
+  assert.equal(r.pendingScopeItems, 1);
+  assert.equal(clientProgress([]).elaboration, null);
+  assert.equal(clientProgress([{ weight: 0, progress: 10, status: "X", approved: false }]).elaboration, null);
+});
+
+test("prazo do cliente = maior data entre os não cancelados", () => {
+  const d = (s) => new Date(s + "T00:00:00.000Z");
+  assert.equal(
+    clientDueDate([
+      { status: "IN_PROGRESS", dueDate: d("2026-11-10") },
+      { status: "CANCELLED", dueDate: d("2027-01-01") },
+      { status: "DONE", dueDate: null },
+    ]).toISOString().slice(0, 10),
+    "2026-11-10",
+  );
+  assert.equal(clientDueDate([]), null);
+});
