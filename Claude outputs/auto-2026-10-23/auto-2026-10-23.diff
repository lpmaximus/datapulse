@@ -0,0 +1,24 @@
+/**
+ * Detecta blobs órfãos: arquivo enviado ao Blob cujo registro (`ProjectFile`)
+ * nunca foi gravado (aba fechada no meio do envio). Módulo puro.
+ *
+ * Só são candidatos blobs mais antigos que `minAgeMs` — um envio em andamento
+ * ainda não tem registro e não pode ser apagado.
+ */
+export type BlobEntry = { pathname: string; uploadedAt: Date };
+
+export const ORPHAN_MIN_AGE_MS = 24 * 60 * 60 * 1000;
+
+export function findOrphanBlobs(
+  blobs: ReadonlyArray<BlobEntry>,
+  registeredPathnames: ReadonlySet<string>,
+  now: Date,
+  minAgeMs: number = ORPHAN_MIN_AGE_MS,
+): BlobEntry[] {
+  return blobs.filter(
+    (b) =>
+      b.pathname.startsWith("projetos/") &&
+      !registeredPathnames.has(b.pathname) &&
+      now.getTime() - b.uploadedAt.getTime() >= minAgeMs,
+  );
+}
diff --git a/lib/budget.ts b/lib/budget.ts
new file mode 100644
index 0000000..d0a933c
--- /dev/null
+++ b/lib/budget.ts
@@ -0,0 +1,150 @@
+import { a1Equivalent, roundTo, type A1Factors, DEFAULT_A1_FACTORS } from "./a1";
+
+/**
+ * Orçamento estimado (decisão de 15/10/2026): a projetista gera o orçamento a
+ * partir dos documentos da LD.
+ *
+ *   estimativa = Σ (folhas × fator do formato) × valor do A1
+ *
+ * O valor do A1 é acertado previamente com cada contratante. Ao APROVAR, o
+ * valor do A1 e a tabela de fatores usados são congelados no orçamento
+ * (snapshot), para que uma mudança de preço depois não altere orçamentos
+ * antigos. Mudança de escopo (LD revisada) gera um orçamento COMPLEMENTAR.
+ *
+ * Módulo puro, testado em `test/budget.test.mjs`.
+ */
+export interface BudgetLineInput {
+  key: string;
+  format: string | null;
+  sheets: number | null;
+}
+
+export interface BudgetLine extends BudgetLineInput {
+  a1Equivalent: number | null;
+  value: number | null;
+}
+
+export interface BudgetResult {
+  lines: BudgetLine[];
+  totalA1: number;
+  total: number;
+  /** Chaves das linhas que não puderam ser precificadas (formato/folhas ausentes ou inválidos). */
+  unpriced: string[];
+}
+
+export function buildBudget(
+  lines: ReadonlyArray<BudgetLineInput>,
+  a1UnitValue: number,
+  factors: A1Factors = DEFAULT_A1_FACTORS,
+): BudgetResult {
+  const unitOk = Number.isFinite(a1UnitValue) && a1UnitValue > 0;
+  const out: BudgetLine[] = [];
+  const unpriced: string[] = [];
+  let totalA1 = 0;
+  for (const l of lines) {
+    const a1 = a1Equivalent(l.format, l.sheets, factors);
+    const value = a1 !== null && unitOk ? roundTo(a1 * a1UnitValue, 2) : null;
+    if (a1 === null || value === null) unpriced.push(l.key);
+    else totalA1 += a1;
+    out.push({ ...l, a1Equivalent: a1, value });
+  }
+  totalA1 = roundTo(totalA1, 3);
+  return {
+    lines: out,
+    totalA1,
+    total: unitOk ? roundTo(totalA1 * a1UnitValue, 2) : 0,
+    unpriced,
+  };
+}
+
+/* --------------------------- Ciclo do orçamento --------------------------- */
+
+export type BudgetStatus = "DRAFT" | "SENT" | "COMMENTED" | "APPROVED" | "CANCELLED";
+export type BudgetAction = "SEND" | "COMMENT" | "APPROVE" | "CANCEL" | "RESEND";
+export type BudgetActor = "DESIGNER" | "CLIENT";
+
+export const BUDGET_STATUS_LABEL: Record<BudgetStatus, string> = {
+  DRAFT: "Rascunho",
+  SENT: "Enviado para avaliação",
+  COMMENTED: "Comentado (devolvido)",
+  APPROVED: "Aprovado",
+  CANCELLED: "Cancelado",
+};
+
+const TRANSITIONS: Record<BudgetStatus, Partial<Record<BudgetAction, { to: BudgetStatus; by: BudgetActor[] }>>> = {
+  DRAFT: { SEND: { to: "SENT", by: ["DESIGNER"] }, CANCEL: { to: "CANCELLED", by: ["DESIGNER"] } },
+  SENT: {
+    COMMENT: { to: "COMMENTED", by: ["CLIENT"] },
+    APPROVE: { to: "APPROVED", by: ["CLIENT"] },
+    CANCEL: { to: "CANCELLED", by: ["CLIENT"] },
+  },
+  COMMENTED: { RESEND: { to: "SENT", by: ["DESIGNER"] }, CANCEL: { to: "CANCELLED", by: ["DESIGNER", "CLIENT"] } },
+  APPROVED: {},
+  CANCELLED: {},
+};
+
+export function isBudgetFinal(status: BudgetStatus): boolean {
+  return status === "APPROVED" || status === "CANCELLED";
+}
+
+/** Ações permitidas ao ator no estado atual. Aprovado e Cancelado ficam travados. */
+export function allowedBudgetActions(status: BudgetStatus, actor: BudgetActor): BudgetAction[] {
+  const map = TRANSITIONS[status] ?? {};
+  return (Object.keys(map) as BudgetAction[]).filter((a) => map[a]?.by.includes(actor));
+}
+
+export function nextBudgetStatus(
+  status: BudgetStatus,
+  action: BudgetAction,
+  actor: BudgetActor,
+): BudgetStatus | null {
+  const t = TRANSITIONS[status]?.[action];
+  return t && t.by.includes(actor) ? t.to : null;
+}
+
+/* ------------------------------ Congelamento ------------------------------ */
+
+export interface BudgetSnapshot {
+  a1UnitValue: number;
+  factors: A1Factors;
+  frozenAt: Date;
+}
+
+/** Congela o valor do A1 e a tabela de fatores no momento da aprovação. */
+export function freezeBudget(a1UnitValue: number, factors: A1Factors, at: Date): BudgetSnapshot {
+  return { a1UnitValue, factors: { ...factors }, frozenAt: at };
+}
+
+/* ------------------------- Orçamento complementar ------------------------- */
+
+/**
+ * Escopo adicionado em relação ao que já foi aprovado: linhas novas e aumento
+ * de A1 equivalente de linhas existentes. Linhas removidas não geram crédito
+ * automático (decisão comercial) — são só reportadas.
+ */
+export function complementaryLines(
+  approved: ReadonlyArray<BudgetLineInput>,
+  revised: ReadonlyArray<BudgetLineInput>,
+  factors: A1Factors = DEFAULT_A1_FACTORS,
+): { added: BudgetLineInput[]; removedKeys: string[] } {
+  const approvedA1 = new Map(approved.map((l) => [l.key, a1Equivalent(l.format, l.sheets, factors) ?? 0]));
+  const revisedKeys = new Set(revised.map((l) => l.key));
+  const added: BudgetLineInput[] = [];
+  for (const l of revised) {
+    const before = approvedA1.get(l.key);
+    if (before === undefined) {
+      added.push(l);
+      continue;
+    }
+    const now = a1Equivalent(l.format, l.sheets, factors) ?? 0;
+    const delta = roundTo(now - before, 3);
+    if (delta > 0) {
+      // Representa só a diferença como folhas do mesmo formato.
+      const factor = factors[(l.format ?? "").toUpperCase()] ?? 0;
+      const extraSheets = factor > 0 ? Math.round(delta / factor) : 0;
+      if (extraSheets > 0) added.push({ key: l.key, format: l.format, sheets: extraSheets });
+    }
+  }
+  const removedKeys = approved.filter((l) => !revisedKeys.has(l.key)).map((l) => l.key);
+  return { added, removedKeys };
+}
