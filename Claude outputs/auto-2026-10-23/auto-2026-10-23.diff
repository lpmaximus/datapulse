@@ -0,0 +1,45 @@
+/**
+ * Migra o legado "pacote de revisão" para "uma tarefa por documento".
+ *
+ * Uso (simulação por padrão; nada é gravado sem --aplicar):
+ *   npx tsx scripts/migrate-documents-to-tasks.ts --organizacao "L2tech"
+ *   npx tsx scripts/migrate-documents-to-tasks.ts --organizacao "L2tech" --aplicar
+ *
+ * RODE PRIMEIRO NUM BRANCH DO NEON (produção e desenvolvimento compartilham o
+ * banco). Pré-requisito: migração 20261023120000_documento_tarefa_demanda_orcamento.
+ * Idempotente: documento que já tem tarefa é ignorado.
+ */
+import { PrismaClient } from "@prisma/client";
+import { migrateDocumentsToTasks } from "../lib/server/document-task-service";
+
+const prisma = new PrismaClient();
+const argv = process.argv.slice(2);
+const APPLY = argv.includes("--aplicar");
+const orgIdx = argv.indexOf("--organizacao");
+const ORG_NAME = orgIdx >= 0 ? argv[orgIdx + 1] : "";
+
+async function main() {
+  if (!ORG_NAME) {
+    console.error('Informe --organizacao "Nome".');
+    process.exit(1);
+  }
+  const org = await prisma.organization.findFirst({ where: { name: ORG_NAME }, select: { id: true, name: true } });
+  if (!org) {
+    console.error(`Organização "${ORG_NAME}" não encontrada.`);
+    process.exit(1);
+  }
+  const s = await migrateDocumentsToTasks(prisma, { organizationId: org.id }, { apply: APPLY });
+  console.log(`${org.name}: ${s.documentsToMigrate} documento(s) a migrar, ${s.alreadyMigrated} já migrado(s).`);
+  if (APPLY) {
+    console.log(`Tarefas criadas: ${s.tasksCreated}. Pacotes vazios removidos: ${s.emptyPackagesRemoved}.`);
+  } else {
+    console.log("Simulação: nada gravado. Use --aplicar para gravar.");
+  }
+}
+
+main()
+  .catch((e) => {
+    console.error(e);
+    process.exit(1);
+  })
+  .finally(() => prisma.$disconnect());
