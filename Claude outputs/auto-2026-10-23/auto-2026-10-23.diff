+import test from "node:test";
+import assert from "node:assert/strict";
+import { dueInfo, buildInbox } from "../lib/inbox.ts";
+
+const d = (s) => new Date(s + "T00:00:00.000Z");
+const today = new Date("2026-10-23T15:00:00.000Z");
+
+test("contagem de dias e tom do vencimento", () => {
+  assert.deepEqual(dueInfo(d("2026-10-22"), today), { daysLeft: -1, tone: "overdue", label: "Venceu há 1 dia" });
+  assert.deepEqual(dueInfo(d("2026-10-20"), today), { daysLeft: -3, tone: "overdue", label: "Venceu há 3 dias" });
+  assert.equal(dueInfo(d("2026-10-23"), today).tone, "today");
+  assert.equal(dueInfo(d("2026-10-24"), today).label, "Vence amanhã");
+  assert.equal(dueInfo(d("2026-10-25"), today).tone, "soon");
+  assert.equal(dueInfo(d("2026-10-30"), today).label, "Vence em 7 dias");
+  assert.equal(dueInfo(null, today).tone, "none");
+});
+
+test("vencidos primeiro, mais atrasado no topo; sem prazo por último", () => {
+  const rows = buildInbox(
+    [
+      { id: "a", kind: "DOCUMENT", label: "A", dueAt: d("2026-10-30"), sentAt: null },
+      { id: "b", kind: "BUDGET", label: "B", dueAt: null, sentAt: d("2026-10-01") },
+      { id: "c", kind: "DOCUMENT", label: "C", dueAt: d("2026-10-20"), sentAt: null },
+      { id: "d", kind: "DOCUMENT", label: "D", dueAt: d("2026-10-22"), sentAt: null },
+    ],
+    today,
+  );
+  assert.deepEqual(rows.map((r) => r.id), ["c", "d", "a", "b"]);
+});
diff --git a/test/ld.test.mjs b/test/ld.test.mjs
new file mode 100644
index 0000000..00d6802
--- /dev/null
+++ b/test/ld.test.mjs
@@ -0,0 +1,55 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { parseLd, diffLd, normalizeHeader } from "../lib/ld.ts";
+
+test("lê a LD por sinônimos de cabeçalho e calcula o A1 equivalente", () => {
+  const r = parseLd([
+    { "Nº do Cliente": "pe-ele-001", "Descrição": "Diagrama unifilar", "Formato": "A1", "Folhas": 3, "Prazo": "30/11/2026", Disciplina: "Elétrica" },
+    { "Nº do Cliente": "PE-ELE-002", "Descrição": "Detalhe", "Formato": "a4", "Folhas": "8", "Prazo": "2026-12-01" },
+    { "Nº do Cliente": "", "Descrição": "", "Formato": "", "Folhas": "" },
+  ]);
+  assert.deepEqual(r.missingColumns, []);
+  assert.equal(r.rows.length, 2);
+  assert.equal(r.rows[0].clientNumber, "PE-ELE-001");
+  assert.equal(r.rows[0].a1Equivalent, 3);
+  assert.equal(r.rows[0].dueDate.toISOString().slice(0, 10), "2026-11-30");
+  assert.equal(r.rows[1].a1Equivalent, 1);
+  assert.equal(r.issues.length, 0);
+});
+
+test("reporta repetidos, folhas e formatos inválidos, e colunas ausentes", () => {
+  const r = parseLd([
+    { Documento: "A-1", Titulo: "x", Formato: "A9", Folhas: 2 },
+    { Documento: "A-1", Titulo: "y" },
+    { Documento: "A-3", Titulo: "z", Formato: "A1", Folhas: "dois" },
+  ]);
+  assert.equal(r.rows.length, 2);
+  assert.equal(r.issues.length, 3);
+  assert.deepEqual(parseLd([{ Foo: 1 }]).missingColumns, ["clientNumber", "name"]);
+});
+
+test("revisão da LD: novos entram, saídos cancelam, mudanças atualizam", () => {
+  const incoming = parseLd([
+    { Documento: "A-1", Titulo: "Um", Formato: "A1", Folhas: 2 },
+    { Documento: "A-2", Titulo: "Dois (novo nome)", Formato: "A1", Folhas: 1 },
+    { Documento: "A-4", Titulo: "Quatro", Formato: "A3", Folhas: 1 },
+    { Documento: "A-5", Titulo: "Cinco" },
+  ]).rows;
+  const existing = [
+    { id: "d1", clientNumber: "a-1", name: "Um", format: "A1", sheets: 2, cancelled: false },
+    { id: "d2", clientNumber: "A-2", name: "Dois", format: "A1", sheets: 1, cancelled: false },
+    { id: "d3", clientNumber: "A-3", name: "Três", format: "A1", sheets: 1, cancelled: false },
+    { id: "d5", clientNumber: "A-5", name: "Cinco", format: null, sheets: null, cancelled: true },
+  ];
+  const diff = diffLd(existing, incoming);
+  assert.deepEqual(diff.create.map((r) => r.clientNumber), ["A-4"]);
+  assert.deepEqual(diff.cancel, ["d3"]);
+  assert.deepEqual(diff.reactivate, ["d5"]);
+  assert.deepEqual(diff.update.map((u) => [u.id, u.changed]), [["d2", ["name"]]]);
+  assert.equal(diff.unchanged, 1);
+});
+
+test("normalizeHeader remove acento, º e pontuação", () => {
+  assert.equal(normalizeHeader("Nº do Cliente"), "n do cliente");
+  assert.equal(normalizeHeader("  Descrição "), "descricao");
+});
diff --git a/test/mail.test.mjs b/test/mail.test.mjs
new file mode 100644
index 0000000..1fd937d
--- /dev/null
+++ b/test/mail.test.mjs
@@ -0,0 +1,42 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { buildNotice, sendNotice, LogOnlyTransport, isSafeUrl } from "../lib/mail.ts";
+
+const base = {
+  kind: "DOCUMENT_SENT",
+  projectName: "Projeto <X>",
+  itemLabel: "PE-ELE-001 — Unifilar",
+  revision: "Rev. B",
+  senderName: "Luiz",
+  url: "https://datapulse.l2techs.com/documents/abc",
+  dueDate: new Date("2026-11-03T00:00:00Z"),
+};
+
+test("aviso: assunto, vencimento e escape de HTML; sem PDF nem comentário", () => {
+  const m = buildNotice(["A@x.com", "a@x.com", "invalido"], base);
+  assert.deepEqual(m.to, ["a@x.com"]);
+  assert.match(m.subject, /Documento enviado para avaliação — PE-ELE-001 — Unifilar \(Rev\. B\)/);
+  assert.match(m.text, /Vencimento: 03\/11\/2026/);
+  assert.match(m.html, /Projeto &lt;X&gt;/);
+  assert.ok(!m.html.includes("<X>"));
+  assert.match(m.text, /apenas um aviso/);
+});
+
+test("sem destinatário válido ou com link inseguro, não monta", () => {
+  assert.equal(buildNotice([], base), null);
+  assert.equal(buildNotice(["a@x.com"], { ...base, url: "javascript:alert(1)" }), null);
+  assert.equal(isSafeUrl("https://a.com/x"), true);
+  assert.equal(isSafeUrl("ftp://a.com"), false);
+});
+
+test("falha de envio nunca lança", async () => {
+  const lines = [];
+  const ok = await sendNotice(new LogOnlyTransport((l) => lines.push(l)), ["a@x.com"], base);
+  assert.equal(ok.sent, true);
+  assert.equal(lines.length, 1);
+  const boom = { name: "boom", send: async () => { throw new Error("rede caiu"); } };
+  const r = await sendNotice(boom, ["a@x.com"], base);
+  assert.deepEqual(r, { sent: false, reason: "rede caiu" });
+  const bad = { name: "bad", send: async () => ({ ok: false, error: "recusado" }) };
+  assert.deepEqual(await sendNotice(bad, ["a@x.com"], base), { sent: false, reason: "recusado" });
+});
diff --git a/test/review-return.test.mjs b/test/review-return.test.mjs
new file mode 100644
index 0000000..67506e8
--- /dev/null
+++ b/test/review-return.test.mjs
@@ -0,0 +1,30 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { validateReturn, canDecideOnRevision, validateCommentFile } from "../lib/review-return.ts";
+
+test("comentar exige PDF ou texto", () => {
+  assert.equal(validateReturn({ decision: "COMMENT" }).ok, false);
+  assert.equal(validateReturn({ decision: "COMMENT", text: "  " }).ok, false);
+  assert.equal(validateReturn({ decision: "COMMENT", text: "ver folha 3" }).ok, true);
+  assert.equal(validateReturn({ decision: "COMMENT", hasFile: true }).ok, true);
+});
+
+test("aprovar não exige nada; cancelar exige motivo", () => {
+  assert.equal(validateReturn({ decision: "APPROVE" }).ok, true);
+  assert.equal(validateReturn({ decision: "CANCEL" }).ok, false);
+  assert.equal(validateReturn({ decision: "CANCEL", text: "duplicado" }).ok, true);
+});
+
+test("projetista não aprova o próprio trabalho", () => {
+  assert.equal(canDecideOnRevision({ id: "u1" }, "u1"), false);
+  assert.equal(canDecideOnRevision({ id: "u2" }, "u1"), true);
+  assert.equal(canDecideOnRevision({ id: "u2" }, null), true);
+});
+
+test("limites do PDF comentado", () => {
+  const ok = { contentType: "application/pdf", sizeBytes: 1000, existingCount: 0 };
+  assert.equal(validateCommentFile(ok).ok, true);
+  assert.equal(validateCommentFile({ ...ok, contentType: "image/png" }).ok, false);
+  assert.equal(validateCommentFile({ ...ok, sizeBytes: 26 * 1024 * 1024 }).ok, false);
+  assert.equal(validateCommentFile({ ...ok, existingCount: 5 }).ok, false);
+});
