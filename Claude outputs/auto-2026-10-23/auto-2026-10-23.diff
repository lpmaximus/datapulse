new file mode 100644
index 0000000..e9231c9
--- /dev/null
+++ b/test/decision.test.mjs
@@ -0,0 +1,76 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { recommend, buildNarrative, validateNarrative, componentDays, DEFAULT_RULES } from "../lib/decision.ts";
+
+const facts = {
+  projectName: "Subestação 2",
+  projectScore: 68.4,
+  previousScore: 60.1,
+  confidence: 0.8,
+  tasks: [
+    {
+      id: "t1", name: "PE-ELE-001 — Unifilar", score: 72, economicExposure: 9000, humanScore: 40, systemicScore: 80,
+      components: { openImpediment: 50, reviewStall: 100, scheduleSlip: 60, silence: 10 }, humanSignalCount: 2,
+    },
+    {
+      id: "t2", name: "PE-CIV-004 — Fundação", score: 60, economicExposure: 150, humanScore: 70, systemicScore: 20,
+      components: { revisionCycles: 66, silence: 80 }, humanSignalCount: 1,
+    },
+    {
+      id: "t3", name: "Tarefa tranquila", score: 10, economicExposure: null, humanScore: null, systemicScore: 10,
+      components: { openImpediment: 90 }, humanSignalCount: 0,
+    },
+  ],
+};
+
+test("recomendações: por regra, na ordem da exposição, ignorando tarefa de baixo risco", () => {
+  const recs = recommend(facts);
+  const byTask = (id) => recs.filter((r) => r.taskId === id).map((r) => r.ruleId);
+  assert.deepEqual(byTask("t1"), ["impedimento-aberto", "atraso-cronograma", "revisao-parada"].sort((a, b) =>
+    DEFAULT_RULES.findIndex((r) => r.id === a) - DEFAULT_RULES.findIndex((r) => r.id === b)));
+  assert.deepEqual(byTask("t2"), ["retrabalho", "silencio-camada-2", "camada1-verde-camada2-vermelha"].sort((a, b) =>
+    DEFAULT_RULES.findIndex((r) => r.id === a) - DEFAULT_RULES.findIndex((r) => r.id === b)));
+  assert.deepEqual(byTask("t3"), []); // score 10 < 35
+  assert.equal(recs[0].taskId, "t1"); // maior exposição primeiro
+  assert.ok(recs.every((r) => r.dueInDays > 0 && r.ownerRole));
+});
+
+test("componente abaixo do mínimo não dispara; limite corta a lista", () => {
+  const recs = recommend(facts);
+  assert.ok(!recs.some((r) => r.taskId === "t1" && r.ruleId === "silencio-camada-2"));
+  assert.equal(recommend(facts, { limit: 2 }).length, 2);
+});
+
+test("narrativa: cita só fatos, com dias derivados e exposição em R$", () => {
+  const n = buildNarrative(facts);
+  assert.match(n.text, /"Subestação 2" está com DRI 68,4 \(restrição provável\)/);
+  assert.match(n.text, /subiu 8,3 ponto\(s\)/);
+  assert.match(n.text, /restrição dominante é "PE-ELE-001 — Unifilar", com DRI 72/);
+  assert.match(n.text, /R\$\s?9\.000,00/);
+  assert.match(n.text, /impedimento aberto há 11 dias/);
+  assert.match(n.text, /revisão parada em análise há 14 dias ou mais/);
+  assert.equal(validateNarrative(n.text, facts).ok, true);
+});
+
+test("validador rejeita número e nome inventados", () => {
+  const bad = 'O projeto "Subestação 2" está com DRI 99,9. A restrição é "Tarefa Fantasma" há 123 dias.';
+  const c = validateNarrative(bad, facts);
+  assert.equal(c.ok, false);
+  assert.ok(c.unknownNumbers.includes("99,9"));
+  assert.ok(c.unknownNumbers.includes("123"));
+  assert.deepEqual(c.unknownNames, ["Tarefa Fantasma"]);
+});
+
+test("sem tarefas com risco, diz isso; baixa confiança é avisada", () => {
+  const calm = buildNarrative({ projectName: "P", projectScore: 5, tasks: [] });
+  assert.match(calm.text, /Não há tarefa aberta com sinal de restrição/);
+  const low = buildNarrative({ ...facts, confidence: 0.4 });
+  assert.match(low.text, /confiança deste score é 40%/);
+  assert.equal(validateNarrative(low.text, { ...facts, confidence: 0.4 }).ok, true);
+});
+
+test("dias a partir do componente e saturação", () => {
+  assert.deepEqual(componentDays(50, 21), { days: 11, saturated: false });
+  assert.deepEqual(componentDays(100, 14), { days: 14, saturated: true });
+  assert.deepEqual(componentDays(-5, 14), { days: 0, saturated: false });
+});
