+    { id: "d3", projectId: "p1", number: "X", name: "Y", taskId: "t1", responsibleId: null, revisions: [] },
+    { id: "d4", projectId: "p1", number: "Z", name: "W", taskId: null, responsibleId: null, revisions: [] },
+  ]);
+  assert.equal(plan.alreadyMigrated, 1);
