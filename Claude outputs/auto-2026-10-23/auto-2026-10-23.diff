+import test from "node:test";
+import assert from "node:assert/strict";
+import { planDocumentTasks, LEGACY_PARENT, taskNameForDocument } from "../lib/document-migration.ts";
+
+const d = (s) => new Date(s + "T00:00:00.000Z");
+const rev = (o) => ({
+  id: "r", status: "DRAFT", sequence: 0, dueAt: null, analyzedAt: null, issuedAt: null,
+  createdAt: d("2026-09-01"), packageParentId: null, ...o,
+});
+
+test("uma tarefa por documento, com o Marco do pacote mais recente", () => {
+  const plan = planDocumentTasks([
+    {
+      id: "d1", projectId: "p1", number: "PE-1", name: "Unifilar", taskId: null, responsibleId: "u1",
+      revisions: [
+        rev({ id: "r0", sequence: 0, status: "COMMENTED", packageParentId: "m1", issuedAt: d("2026-09-02"), dueAt: d("2026-09-09"), analyzedAt: d("2026-09-08") }),
+        rev({ id: "r1", sequence: 1, status: "IN_REVIEW", packageParentId: "m2", issuedAt: d("2026-09-20"), dueAt: d("2026-09-27") }),
+      ],
+    },
+  ]);
+  assert.equal(plan.tasks.length, 1);
+  const t = plan.tasks[0];
+  assert.equal(t.parentId, "m2");
+  assert.equal(t.name, "PE-1 — Unifilar");
+  assert.equal(t.status, "IN_REVIEW");
+  assert.equal(t.progress, 100);
+  assert.equal(t.plannedDate.toISOString().slice(0, 10), "2026-09-09");
+  assert.equal(t.forecastDate.toISOString().slice(0, 10), "2026-09-27");
+  assert.deepEqual(t.revisionIds, ["r0", "r1"]);
+  assert.equal(t.assigneeId, "u1");
+});
+
+test("sem pacote vai para o Legado; aprovado fecha com a data da aprovação", () => {
+  const plan = planDocumentTasks([
+    {
+      id: "d2", projectId: "p1", number: null, name: "Memorial", taskId: null, responsibleId: null,
+      revisions: [rev({ id: "r9", status: "APPROVED", analyzedAt: d("2026-10-01"), issuedAt: d("2026-09-20") })],
+    },
+  ]);
+  const t = plan.tasks[0];
+  assert.equal(t.parentId, LEGACY_PARENT);
+  assert.equal(t.status, "DONE");
