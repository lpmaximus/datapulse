@@ -0,0 +1,113 @@
+import { projectDocumentTask, type DocTaskStatus } from "./document-task";
+import type { DocumentStatus } from "./documents";
+
+/**
+ * Planejamento da migração "pacote -> uma tarefa por documento" (decisão de
+ * 15/10/2026). Módulo puro: recebe os documentos como estão hoje e devolve a
+ * tarefa que cada um deve ganhar. A gravação fica em
+ * `scripts/migrate-documents-to-tasks.ts` (simulação por padrão).
+ *
+ * Regras:
+ *  - Documento que já tem tarefa (taskId) é ignorado (idempotente).
+ *  - Marco pai = o do pacote da revisão mais recente que tenha pacote; sem
+ *    pacote nenhum, o Marco "Legado — documentos existentes" do projeto.
+ *  - Status/avanço/datas saem de `projectDocumentTask` sobre a revisão vigente
+ *    (maior sequência). Documento sem revisão em análise/aprovada começa em 0%.
+ *  - Todas as revisões do documento passam a apontar para a nova tarefa.
+ */
+export const LEGACY_PARENT = "LEGACY" as const;
+
+/** Marco que recebe os documentos sem pacote (mesmo nome usado no legado dos pacotes). */
+export const LEGACY_MARCO_TITLE = "Legado — documentos existentes";
+
+export interface MigrationRevision {
+  id: string;
+  status: DocumentStatus;
+  sequence: number;
+  dueAt: Date | null;
+  analyzedAt: Date | null;
+  issuedAt: Date | null;
+  createdAt: Date;
+  /** Pacote atual da revisão (se houver) e o Marco em que ele está. */
+  packageParentId: string | null;
+}
+
+export interface MigrationDocument {
+  id: string;
+  projectId: string;
+  number: string | null;
+  name: string;
+  taskId: string | null;
+  responsibleId: string | null;
+  revisions: MigrationRevision[];
+}
+
+export interface DocumentTaskPlan {
+  documentId: string;
+  projectId: string;
+  name: string;
+  /** Id do Marco ou LEGACY_PARENT. */
+  parentId: string | typeof LEGACY_PARENT;
+  assigneeId: string | null;
+  status: DocTaskStatus;
+  progress: number;
+  startDate: Date | null;
+  actualStartDate: Date | null;
+  plannedDate: Date | null;
+  forecastDate: Date | null;
+  actualDate: Date | null;
+  revisionIds: string[];
+}
+
+export interface MigrationPlan {
+  tasks: DocumentTaskPlan[];
+  alreadyMigrated: number;
+}
+
+export function taskNameForDocument(d: { number: string | null; name: string }): string {
+  return d.number ? `${d.number} — ${d.name}` : d.name;
+}
+
+export function planDocumentTasks(docs: ReadonlyArray<MigrationDocument>): MigrationPlan {
+  const plan: MigrationPlan = { tasks: [], alreadyMigrated: 0 };
+  for (const d of docs) {
+    if (d.taskId) {
+      plan.alreadyMigrated += 1;
+      continue;
+    }
+    const revs = [...d.revisions].sort((a, b) => a.sequence - b.sequence);
+    const current = revs.length ? revs[revs.length - 1] : null;
+
+    const withPackage = [...revs].reverse().find((r) => r.packageParentId);
+    const parentId = withPackage?.packageParentId ?? LEGACY_PARENT;
+
+    const proj = projectDocumentTask({
+      current: current
+        ? { status: current.status, dueAt: current.dueAt, analyzedAt: current.analyzedAt }
+        : null,
+      declaredProgress: 0,
+    });
+
+    const dues = revs.map((r) => r.dueAt).filter((x): x is Date => !!x);
+    const plannedDate = dues.length ? new Date(Math.min(...dues.map((x) => x.getTime()))) : null;
+    const starts = revs.map((r) => r.issuedAt ?? r.createdAt);
+    const start = starts.length ? new Date(Math.min(...starts.map((x) => x.getTime()))) : null;
+
+    plan.tasks.push({
+      documentId: d.id,
+      projectId: d.projectId,
+      name: taskNameForDocument(d),
+      parentId,
+      assigneeId: d.responsibleId,
+      status: proj.status,
+      progress: proj.progress,
+      startDate: start,
+      actualStartDate: proj.progress > 0 ? start : null,
+      plannedDate,
+      forecastDate: proj.forecastDate ?? plannedDate,
+      actualDate: proj.actualDate,
+      revisionIds: revs.map((r) => r.id),
+    });
+  }
+  return plan;
+}
