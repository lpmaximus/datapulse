diff --git a/test/budget.test.mjs b/test/budget.test.mjs
new file mode 100644
index 0000000..0731187
--- /dev/null
+++ b/test/budget.test.mjs
@@ -0,0 +1,64 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  buildBudget, allowedBudgetActions, nextBudgetStatus, freezeBudget, complementaryLines, isBudgetFinal,
+} from "../lib/budget.ts";
+
+test("estimativa = Σ(folhas × fator) × valor do A1", () => {
+  const b = buildBudget(
+    [
+      { key: "a", format: "A1", sheets: 2 }, // 2
+      { key: "b", format: "A3", sheets: 4 }, // 1
+      { key: "c", format: "A4", sheets: 8 }, // 1
+      { key: "d", format: null, sheets: 3 }, // sem preço
+    ],
+    1000,
+  );
+  assert.equal(b.totalA1, 4);
+  assert.equal(b.total, 4000);
+  assert.deepEqual(b.unpriced, ["d"]);
+  assert.equal(b.lines[0].value, 2000);
+});
+
+test("sem valor do A1 válido, nada é precificado", () => {
+  const b = buildBudget([{ key: "a", format: "A1", sheets: 1 }], 0);
+  assert.equal(b.total, 0);
+  assert.deepEqual(b.unpriced, ["a"]);
+});
+
+test("ciclo: projetista envia; contratante aprova/comenta/cancela; final trava", () => {
+  assert.deepEqual(allowedBudgetActions("DRAFT", "DESIGNER").sort(), ["CANCEL", "SEND"]);
+  assert.deepEqual(allowedBudgetActions("DRAFT", "CLIENT"), []);
+  assert.equal(nextBudgetStatus("SENT", "APPROVE", "CLIENT"), "APPROVED");
+  assert.equal(nextBudgetStatus("SENT", "APPROVE", "DESIGNER"), null); // não aprova o próprio trabalho
+  assert.equal(nextBudgetStatus("SENT", "COMMENT", "CLIENT"), "COMMENTED");
+  assert.equal(nextBudgetStatus("COMMENTED", "RESEND", "DESIGNER"), "SENT");
+  assert.deepEqual(allowedBudgetActions("APPROVED", "CLIENT"), []);
+  assert.equal(isBudgetFinal("CANCELLED"), true);
+  assert.equal(isBudgetFinal("SENT"), false);
+});
+
+test("congelar guarda cópia da tabela de fatores", () => {
+  const f = { A1: 1 };
+  const snap = freezeBudget(900, f, new Date("2026-10-23T00:00:00Z"));
+  f.A1 = 99;
+  assert.equal(snap.factors.A1, 1);
+  assert.equal(snap.a1UnitValue, 900);
+});
+
+test("complementar: linhas novas e aumento de folhas; removidas só reportadas", () => {
+  const approved = [
+    { key: "a", format: "A1", sheets: 2 },
+    { key: "b", format: "A1", sheets: 1 },
+  ];
+  const revised = [
+    { key: "a", format: "A1", sheets: 5 }, // +3
+    { key: "c", format: "A2", sheets: 2 }, // novo
+  ];
+  const r = complementaryLines(approved, revised);
+  assert.deepEqual(r.added, [
+    { key: "a", format: "A1", sheets: 3 },
+    { key: "c", format: "A2", sheets: 2 },
+  ]);
+  assert.deepEqual(r.removedKeys, ["b"]);
+});
