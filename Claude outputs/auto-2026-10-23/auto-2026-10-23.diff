@@ -0,0 +1,91 @@
+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { requireUser } from "@/lib/authz";
+import { Card, DRIBadge, Empty, SectionTitle } from "@/components/ui";
+import { buildNarrative, formatBRL, recommend, validateNarrative } from "@/lib/decision";
+import { loadDecisionFacts } from "@/lib/server/decision-service";
+
+export const dynamic = "force-dynamic";
+
+/**
+ * Decision OS — Fase 1: "Por que o DRI está assim" e "O que fazer".
+ * Somente leitura: explica o último snapshot do DRI, não recalcula nada.
+ * Narrativa por template (sem IA), conferida contra os fatos.
+ */
+export default async function DecisionExplanationPage({
+  params,
+}: {
+  params: Promise<{ id: string }>;
+}) {
+  const { id } = await params;
+  const user = await requireUser(`/projects/${id}/explicacao`);
+
+  const facts = await loadDecisionFacts(id, user);
+  if (!facts) notFound();
+
+  const narrative = buildNarrative(facts);
+  const check = validateNarrative(narrative.text, facts);
+  const recs = recommend(facts, { limit: 12 });
+
+  return (
+    <div className="space-y-6">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div>
+          <Link href={`/projects/${id}`} className="text-sm text-ink-faint hover:underline">
+            ← {facts.projectName}
+          </Link>
+          <h1 className="mt-1 text-xl font-semibold">Explicação do DRI</h1>
+        </div>
+        <DRIBadge score={facts.projectScore} />
+      </div>
+
+      <Card>
+        <SectionTitle hint="Texto gerado por regras a partir dos fatos do último cálculo do DRI.">
+          Por que o DRI está assim
+        </SectionTitle>
+        <div className="space-y-2 text-sm leading-relaxed">
+          {narrative.sentences.map((s, i) => (
+            <p key={i}>{s}</p>
+          ))}
+        </div>
+        {!check.ok ? (
+          <p className="mt-3 text-xs text-ink-faint">
+            Atenção: o texto contém dado que não confere com os fatos e deve ser ignorado.
+          </p>
+        ) : null}
+        <p className="mt-3 text-xs text-ink-faint">
+          Esta página só explica o DRI; o cálculo continua sendo o do cron diário e das ações de documento.
+        </p>
+      </Card>
+
+      <Card>
+        <SectionTitle hint="Priorizadas por exposição econômica e depois por score.">
+          O que fazer
+        </SectionTitle>
+        {recs.length === 0 ? (
+          <Empty>Nenhuma decisão recomendada para o último cálculo do DRI.</Empty>
+        ) : (
+          <ol className="space-y-3">
+            {recs.map((r) => (
+              <li key={`${r.taskId}-${r.ruleId}`} className="rounded-lg border border-line p-3 text-sm">
+                <div className="flex flex-wrap items-center gap-2">
+                  <Link href={`/projects/${id}/tasks/${r.taskId}`} className="font-medium hover:underline">
+                    {r.taskName}
+                  </Link>
+                  <span className="text-xs text-ink-faint">
+                    DRI {r.taskScore}
+                    {r.economicExposure != null ? ` · exposição ${formatBRL(r.economicExposure)}` : ""}
+                  </span>
+                </div>
+                <p className="mt-1">{r.text}</p>
+                <p className="mt-1 text-xs text-ink-faint">
+                  Sugestão: {r.ownerRole}, em até {r.dueInDays} dia(s).
+                </p>
+              </li>
+            ))}
+          </ol>
+        )}
+      </Card>
+    </div>
+  );
+}
