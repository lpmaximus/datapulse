@@ -0,0 +1,24 @@
+/**
+ * Autorização das rotas de cron (Vercel Cron envia `Authorization: Bearer $CRON_SECRET`).
+ *
+ * Fail-closed: sem `CRON_SECRET` configurado NINGUÉM é autorizado. Antes, a
+ * checagem era `if (secret && auth !== ...)`, o que deixava a rota pública
+ * se a variável sumisse do ambiente.
+ *
+ * Módulo puro, testado em `test/cron-auth.test.mjs`.
+ */
+export function isCronAuthorized(
+  secret: string | undefined | null,
+  authorizationHeader: string | null | undefined,
+): boolean {
+  if (!secret || secret.trim().length === 0) return false;
+  if (!authorizationHeader) return false;
+  const expected = `Bearer ${secret}`;
+  if (authorizationHeader.length !== expected.length) return false;
+  // Comparação em tempo constante.
+  let diff = 0;
+  for (let i = 0; i < expected.length; i++) {
+    diff |= expected.charCodeAt(i) ^ authorizationHeader.charCodeAt(i);
+  }
+  return diff === 0;
+}
diff --git a/lib/decision.ts b/lib/decision.ts
new file mode 100644
index 0000000..f786119
--- /dev/null
+++ b/lib/decision.ts
@@ -0,0 +1,363 @@
+import { BAND_LABEL, DRI_CONFIG, driBand, rankByExposure } from "./dri";
+
+/**
+ * Decision OS — Fase 1 (sem IA e sem MiroFish). Camada que LÊ o DRI e explica:
+ *   1. por que o DRI está neste valor (narrativa por template);
+ *   2. o que fazer a respeito (decisões recomendadas por regras fixas, com
+ *      dono e prazo).
+ *
+ * O DRI continua sendo o único dono do cálculo: este módulo NUNCA recalcula
+ * nada, só lê os fatos (score, componentes e exposição de cada tarefa).
+ * Todo número e nome do texto vem dos fatos, e `validateNarrative` confere isso
+ * — barreira necessária quando, nas fases seguintes, um LLM puder reescrever o
+ * texto.
+ *
+ * Módulo puro, testado em `test/decision.test.mjs`.
+ */
+
+/* --------------------------------- Fatos --------------------------------- */
+
+export interface TaskFact {
+  id: string;
+  name: string;
+  /** DRI da tarefa (0–100). */
+  score: number;
+  /** Exposição econômica em R$ (score ÷ 100 × valor), se a tarefa tem valor. */
+  economicExposure?: number | null;
+  humanScore?: number | null;
+  systemicScore?: number | null;
+  /** Valor (0–100) de cada componente do breakdown, por chave (Camada 1 e 2 juntas). */
+  components: Record<string, number>;
+  /** Quantas avaliações humanas recentes existem (0 = silêncio total). */
+  humanSignalCount: number;
+}
+
+export interface DecisionFacts {
+  projectName: string;
+  projectScore: number;
+  /** Score do projeto há ~7 dias, se existir. */
+  previousScore?: number | null;
+  /** 0–1, confiança do score da tarefa dominante. */
+  confidence?: number | null;
+  /** Tarefas-folha abertas, com seus fatos. */
+  tasks: TaskFact[];
+}
+
+/* --------------------------------- Regras -------------------------------- */
+
+export type OwnerRole = "Gerente" | "Especialista" | "Gerente / especialista";
+
+export interface DecisionRule {
+  id: string;
+  /** Componente do breakdown que dispara a regra. */
+  component?: string;
+  /** Valor mínimo (0–100) do componente para disparar. */
+  minValue?: number;
+  /** Recomendação-base. */
+  recommendation: string;
+  ownerRole: OwnerRole;
+  dueInDays: number;
+}
+
+export const DEFAULT_MIN_COMPONENT_VALUE = 20;
+
+/** Regras fixas da fase 1 (tabela da seção 8 do desenho + ritmo, novo no mvp-3). */
+export const DEFAULT_RULES: DecisionRule[] = [
+  {
+    id: "impedimento-aberto",
+    component: "openImpediment",
+    recommendation: "Escalar a quem resolve o impedimento e fixar uma data de resposta.",
+    ownerRole: "Gerente",
+    dueInDays: 2,
+  },
+  {
+    id: "solicitacao-vencida",
+    component: "overdueRequests",
+    recommendation: "Cobrar a parte externa da solicitação vencida; considerar reprogramar.",
+    ownerRole: "Gerente",
+    dueInDays: 3,
+  },
+  {
+    id: "revisao-parada",
+    component: "reviewStall",
+    recommendation: "Cobrar o parecer da revisão em análise ou redistribuir a análise a outro especialista.",
+    ownerRole: "Gerente / especialista",
+    dueInDays: 2,
+  },
+  {
+    id: "retrabalho",
+    component: "revisionCycles",
+    recommendation: "Alinhar o critério de aceite entre o emissor e o analista antes da próxima revisão.",
+    ownerRole: "Especialista",
+    dueInDays: 5,
+  },
+  {
+    id: "atraso-cronograma",
+    component: "scheduleSlip",
+    recommendation: "Recuperar o prazo ou reprogramar formalmente (registrando no histórico de prazo).",
+    ownerRole: "Gerente",
+    dueInDays: 5,
+  },
+  {
+    id: "ritmo",
+    component: "pace",
+    recommendation: "O avanço está abaixo do esperado para a data: revisar capacidade e prioridade antes de o prazo vencer.",
+    ownerRole: "Gerente",
+    dueInDays: 3,
+  },
+  {
+    id: "silencio-camada-2",
+    component: "silence",
+    minValue: 50,
+    recommendation: "Convocar uma nova avaliação (Camada 2): faz tempo que ninguém diz como esta tarefa está.",
+    ownerRole: "Gerente",
+    dueInDays: 3,
+  },
+  {
+    id: "camada1-verde-camada2-vermelha",
+    recommendation: "Os registros estão em ordem, mas a equipe sente risco: investigar a restrição que não foi registrada.",
+    ownerRole: "Gerente",
+    dueInDays: 5,
+  },
+];
+
+export interface Recommendation {
+  ruleId: string;
+  taskId: string;
+  taskName: string;
+  text: string;
+  ownerRole: OwnerRole;
+  dueInDays: number;
+  /** Valor do componente (0–100) ou score da tarefa — o que sustenta a recomendação. */
+  evidence: number;
+  taskScore: number;
+  economicExposure: number | null;
+}
+
+/** Camada 1 "verde" e Camada 2 "vermelha" (faixas do `driBand`). */
+function greenVsRed(t: TaskFact): boolean {
+  if (t.systemicScore == null || t.humanScore == null) return false;
+  return driBand(t.systemicScore) === "low" && (driBand(t.humanScore) === "high" || driBand(t.humanScore) === "critical");
+}
+
+/**
+ * Recomendações para as tarefas do projeto. Só tarefas com algum risco
+ * (score ≥ `minTaskScore`) geram recomendação. Ordem: exposição econômica,
+ * depois score (a mesma prioridade de destravamento do DRI mvp-3). No máximo
+ * uma recomendação por regra e tarefa.
+ */
+export function recommend(
+  facts: DecisionFacts,
+  opts: { rules?: DecisionRule[]; minTaskScore?: number; limit?: number } = {},
+): Recommendation[] {
+  const rules = opts.rules ?? DEFAULT_RULES;
+  const minTaskScore = opts.minTaskScore ?? 35;
+  const out: Recommendation[] = [];
+
+  for (const task of rankByExposure(facts.tasks)) {
+    if (task.score < minTaskScore) continue;
+    for (const rule of rules) {
+      let evidence: number | null = null;
+      if (rule.component) {
+        const v = task.components[rule.component];
+        const min = rule.minValue ?? DEFAULT_MIN_COMPONENT_VALUE;
+        if (v !== undefined && v >= min) evidence = v;
+      } else if (rule.id === "camada1-verde-camada2-vermelha" && greenVsRed(task)) {
+        evidence = task.humanScore ?? null;
+      }
+      if (evidence === null) continue;
+      out.push({
+        ruleId: rule.id,
+        taskId: task.id,
+        taskName: task.name,
+        text: rule.recommendation,
+        ownerRole: rule.ownerRole,
+        dueInDays: rule.dueInDays,
+        evidence: Math.round(evidence * 10) / 10,
+        taskScore: Math.round(task.score * 10) / 10,
+        economicExposure: task.economicExposure ?? null,
+      });
+    }
+  }
+  return typeof opts.limit === "number" ? out.slice(0, opts.limit) : out;
+}
+
+/* -------------------------------- Narrativa ------------------------------- */
+
+export interface Narrative {
+  text: string;
+  /** Frases individuais (cada uma lastreada em fatos), para a UI renderizar chips. */
+  sentences: string[];
+}
+
+function fmt1(n: number): string {
+  return (Math.round(n * 10) / 10).toLocaleString("pt-BR", { minimumFractionDigits: 0, maximumFractionDigits: 1 });
+}
+
+export function formatBRL(n: number): string {
+  return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
+}
+
+/**
+ * Converte o valor normalizado de um componente de tempo de volta em dias
+ * (aproximado) usando o horizonte de saturação do DRI. Saturado = "ou mais".
+ */
+export function componentDays(value: number, horizonDays: number): { days: number; saturated: boolean } {
+  const saturated = value >= 100;
+  return { days: Math.round((Math.min(100, Math.max(0, value)) / 100) * horizonDays), saturated };
+}
+
+function factSentence(componentKey: string, value: number): string | null {
+  switch (componentKey) {
+    case "openImpediment": {
+      const { days, saturated } = componentDays(value, DRI_CONFIG.impedimentHorizonDays);
+      return `há um impedimento aberto há ${days} dias${saturated ? " ou mais" : ""}`;
+    }
+    case "overdueRequests": {
+      const { days, saturated } = componentDays(value, DRI_CONFIG.requestOverdueHorizonDays);
+      return `há solicitação vencida há ${days} dias${saturated ? " ou mais" : ""}`;
+    }
+    case "reviewStall": {
+      const { days, saturated } = componentDays(value, DRI_CONFIG.reviewStallHorizonDays);
+      return `há revisão parada em análise há ${days} dias${saturated ? " ou mais" : ""}`;
+    }
+    case "revisionCycles":
+      return "um documento já voltou várias vezes para revisão";
+    case "scheduleSlip": {
+      const { days, saturated } = componentDays(value, DRI_CONFIG.slipHorizonDays);
+      return `o prazo está atrasado ${days} dias${saturated ? " ou mais" : ""} em relação ao planejado`;
+    }
+    case "pace":
+      return "o avanço está abaixo do esperado para a data";
+    case "silence":
+      return "faz tempo que ninguém avalia a tarefa";
+    default:
+      return null;
+  }
+}
+
+/** Ordem em que os fatos aparecem na narrativa (do mais para o menos grave). */
+const FACT_ORDER = ["openImpediment", "scheduleSlip", "reviewStall", "overdueRequests", "pace", "revisionCycles", "silence"];
+
+/**
+ * Narrativa "por que o DRI está assim": 3 a 5 frases por template, todas
+ * lastreadas em fatos. Sem tarefas abertas com risco, diz isso com clareza.
+ */
+export function buildNarrative(facts: DecisionFacts): Narrative {
+  const band = BAND_LABEL[driBand(facts.projectScore)];
+  const sentences: string[] = [];
+
+  let head = `O projeto "${facts.projectName}" está com DRI ${fmt1(facts.projectScore)} (${band.toLowerCase()})`;
+  if (facts.previousScore != null) {
+    const delta = Math.round((facts.projectScore - facts.previousScore) * 10) / 10;
+    if (delta === 0) head += ", igual há 7 dias";
+    else head += `, ${delta > 0 ? "subiu" : "caiu"} ${fmt1(Math.abs(delta))} ponto(s) em relação a 7 dias atrás`;
+  }
+  sentences.push(head + ".");
+
+  const ranked = rankByExposure(facts.tasks.filter((t) => t.score > 0));
+  const dominant = ranked[0];
+  if (!dominant) {
+    sentences.push("Não há tarefa aberta com sinal de restrição neste momento.");
+    return { text: sentences.join(" "), sentences };
+  }
+
+  let dom = `A restrição dominante é "${dominant.name}", com DRI ${fmt1(dominant.score)}`;
+  if (dominant.economicExposure != null) dom += ` e exposição de ${formatBRL(dominant.economicExposure)}`;
+  sentences.push(dom + ".");
+
+  const reasons = FACT_ORDER.flatMap((key) => {
+    const v = dominant.components[key];
+    if (v === undefined || v < DEFAULT_MIN_COMPONENT_VALUE) return [];
+    const s = factSentence(key, v);
+    return s ? [s] : [];
+  }).slice(0, 3);
+  if (reasons.length > 0) {
+    sentences.push(`Nela, ${reasons.join("; ")}.`);
+  } else if (greenVsRed(dominant)) {
+    sentences.push("Os registros estão em ordem, mas a percepção da equipe indica risco que ainda não foi registrado.");
+  }
+
+  const others = ranked.filter((t) => t.score >= 55 && t.id !== dominant.id).length;
+  if (others > 0) {
+    sentences.push(`Além dela, ${others} outra(s) tarefa(s) estão em faixa de restrição provável ou dominante.`);
+  }
+
+  if (facts.confidence != null && facts.confidence < 0.6) {
+    sentences.push(
+      `A confiança deste score é ${fmt1(facts.confidence * 100)}%: trate como indicativo, não como conclusivo.`,
+    );
+  }
+
+  return { text: sentences.join(" "), sentences };
+}
+
+/* -------------------------------- Validador ------------------------------- */
+
+function collectNumbers(value: unknown, into: number[]): void {
+  if (typeof value === "number" && Number.isFinite(value)) into.push(value);
+  else if (Array.isArray(value)) value.forEach((v) => collectNumbers(v, into));
+  else if (value && typeof value === "object") Object.values(value).forEach((v) => collectNumbers(v, into));
+}
+
+/** Números derivados que a narrativa pode legitimamente citar (dias, deltas, %). */
+function derivedNumbers(facts: DecisionFacts): number[] {
+  const out: number[] = [];
+  if (facts.previousScore != null) out.push(Math.abs(Math.round((facts.projectScore - facts.previousScore) * 10) / 10));
+  if (facts.confidence != null) out.push(facts.confidence * 100);
+  for (const t of facts.tasks) {
+    const c = t.components;
+    if (c.openImpediment !== undefined) out.push(componentDays(c.openImpediment, DRI_CONFIG.impedimentHorizonDays).days);
+    if (c.overdueRequests !== undefined) out.push(componentDays(c.overdueRequests, DRI_CONFIG.requestOverdueHorizonDays).days);
+    if (c.reviewStall !== undefined) out.push(componentDays(c.reviewStall, DRI_CONFIG.reviewStallHorizonDays).days);
+    if (c.scheduleSlip !== undefined) out.push(componentDays(c.scheduleSlip, DRI_CONFIG.slipHorizonDays).days);
+  }
+  out.push(...[7, 0]);
+  // contagens de tarefas
+  out.push(facts.tasks.length);
+  for (let i = 0; i <= facts.tasks.length; i++) out.push(i);
+  return out;
+}
+
+/** Interpreta "1.234,56" / "12,5" / "7" (pt-BR) como número. */
+function parsePtBr(token: string): number {
+  return Number(token.replace(/\./g, "").replace(",", "."));
+}
+
+export interface NarrativeCheck {
+  ok: boolean;
+  /** Números do texto que não existem nos fatos. */
+  unknownNumbers: string[];
+  /** Nomes entre aspas que não são do projeto nem de nenhuma tarefa. */
+  unknownNames: string[];
+}
+
+/**
+ * Confere que TODO número e todo nome entre aspas do texto existem nos fatos.
+ * Hoje a narrativa vem de template e passa sempre; o validador existe para o
+ * dia em que um LLM reescrever o texto (fase 2+): texto que inventa número ou
+ * nome é descartado e vale o template.
+ */
+export function validateNarrative(text: string, facts: DecisionFacts): NarrativeCheck {
+  const allowed: number[] = [];
+  collectNumbers(
+    {
+      p: facts.projectScore,
+      t: facts.tasks.map((t) => [t.score, t.economicExposure, t.humanScore, t.systemicScore, Object.values(t.components)]),
+    },
+    allowed,
+  );
+  allowed.push(...derivedNumbers(facts));
+
+  const tokens = text.match(/\d{1,3}(?:\.\d{3})+(?:,\d+)?|\d+(?:,\d+)?/g) ?? [];
+  const unknownNumbers = tokens.filter((tok) => {
+    const x = parsePtBr(tok);
+    return !allowed.some((a) => Math.abs(a - x) < 0.06 || Math.abs(Math.round(a) - x) < 0.51 && Number.isInteger(x));
+  });
+
+  const names = new Set<string>([facts.projectName, ...facts.tasks.map((t) => t.name)]);
+  const quoted = [...text.matchAll(/"([^"]+)"/g)].map((m) => m[1]);
+  const unknownNames = quoted.filter((q) => !names.has(q));
+
+  return { ok: unknownNumbers.length === 0 && unknownNames.length === 0, unknownNumbers, unknownNames };
+}
