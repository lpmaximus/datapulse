+  /** Exposição econômica somada das filhas (R$); nula se nenhuma tem valor. */
+  economicExposure: number | null;
+} {
+  if (children.length === 0) {
+    return { score: 0, dominantChild: null, childCount: 0, economicExposure: null };
+  }
   const top = children.reduce((a, b) => (b.score > a.score ? b : a));
-  return { score: top.score, dominantChild: top.name, childCount: children.length };
+  const exposures = children.map((c) => c.economicExposure).filter((x): x is number => x != null);
+  const economicExposure = exposures.length
+    ? Math.round(exposures.reduce((a, b) => a + b, 0) * 100) / 100
+    : null;
+  return { score: top.score, dominantChild: top.name, childCount: children.length, economicExposure };
+}
+
+/**
+ * Prioridade de destravamento ("o que destravar primeiro"): ordena pela
+ * exposição econômica (score ÷ 100 × valor), para que um A1 grande travado
+ * apareça antes de um A4 travado com o mesmo score. Sem exposição em algum
+ * dos dois, cai no score. Estável em empate.
+ */
+export function rankByExposure<T extends { score: number; economicExposure?: number | null }>(
+  items: ReadonlyArray<T>,
+): T[] {
+  return items
+    .map((item, index) => ({ item, index }))
+    .sort((a, b) => {
+      const ea = a.item.economicExposure ?? null;
+      const eb = b.item.economicExposure ?? null;
+      if (ea != null && eb != null && ea !== eb) return eb - ea;
+      if (b.item.score !== a.item.score) return b.item.score - a.item.score;
+      return a.index - b.index;
+    })
+    .map((x) => x.item);
 }
 
 export type DRIBand = "low" | "watch" | "high" | "critical";
