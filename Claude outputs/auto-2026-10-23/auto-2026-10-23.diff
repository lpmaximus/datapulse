@@ -0,0 +1,41 @@
+import { prisma } from "@/lib/prisma";
+import { a1Equivalent, normalizeFormat, parseA1Factors, type A1Factors } from "@/lib/a1";
+
+/** Tabela de fatores do A1 da organização (ou o padrão). */
+export async function loadA1Factors(organizationId: string): Promise<A1Factors> {
+  const org = await prisma.organization.findUnique({
+    where: { id: organizationId },
+    select: { a1Factors: true },
+  });
+  return parseA1Factors(org?.a1Factors ?? null);
+}
+
+export type DocumentSize =
+  | { error: string }
+  | { designerNumber: string | null; format: string | null; sheets: number | null; a1Equivalent: number | null };
+
+/**
+ * Lê número do projetista, formato e folhas do formulário e calcula o A1
+ * equivalente. Campos vazios são válidos (documento ainda sem tamanho); formato
+ * fora da tabela ou folhas que não sejam um inteiro positivo são erro.
+ */
+export function readDocumentSize(fd: FormData, factors: A1Factors): DocumentSize {
+  const designerNumber = String(fd.get("designerNumber") ?? "").trim() || null;
+  const format = normalizeFormat(fd.get("format"));
+  const sheetsRaw = String(fd.get("sheets") ?? "").trim();
+  let sheets: number | null = null;
+  if (sheetsRaw) {
+    const n = Number(sheetsRaw.replace(",", "."));
+    if (!Number.isInteger(n) || n < 1) return { error: "Folhas deve ser um número inteiro maior que zero." };
+    sheets = n;
+  }
+  if (format && factors[format] === undefined) {
+    return { error: `Formato "${format}" não está na tabela de fatores (${Object.keys(factors).join(", ")}).` };
+  }
+  return {
+    designerNumber,
+    format,
+    sheets,
+    a1Equivalent: format && sheets !== null ? a1Equivalent(format, sheets, factors) : null,
+  };
+}
diff --git a/lib/server/document-task-service.ts b/lib/server/document-task-service.ts
new file mode 100644
index 0000000..9827ed3
--- /dev/null
+++ b/lib/server/document-task-service.ts
@@ -0,0 +1,291 @@
+import { prisma } from "@/lib/prisma";
+import {
+  DOCUMENT_TASK_TYPE,
+  PACKAGE_TYPE,
+  buildDeadlineChange,
+  isDocumentTaskType,
+  validateParentLink,
+} from "@/lib/tasks";
+import type { DocumentStatus } from "@/lib/documents";
+import { projectDocumentTask, shouldStampActualStart } from "@/lib/document-task";
+import {
+  LEGACY_MARCO_TITLE,
+  LEGACY_PARENT,
+  planDocumentTasks,
+  taskNameForDocument,
+  type MigrationDocument,
+} from "@/lib/document-migration";
+import { recomputeRollup, type Db } from "@/lib/server/rollup";
+
+/**
+ * Documento como Tarefa (decisão de 15/10/2026): cada documento tem a SUA
+ * tarefa (Milestone, type "Documento"). Status, avanço, prazo e fim real são
+ * PROJEÇÃO do ciclo de revisão do documento (lib/document-task.ts) — nunca
+ * digitados, no mesmo espírito do rollup do Marco.
+ */
+
+/** Recalcula a tarefa de um documento e propaga ao Marco pai. */
+export async function recomputeDocumentTask(milestoneId: string, db: Db = prisma) {
+  const task = await db.milestone.findUnique({
+    where: { id: milestoneId },
+    select: {
+      id: true,
+      type: true,
+      parentId: true,
+      progress: true,
+      actualStartDate: true,
+      plannedDate: true,
+      forecastDate: true,
+      impediments: { where: { resolvedAt: null }, select: { id: true }, take: 1 },
+      documentTask: { select: { declaredProgress: true } },
+      documentRevisions: {
+        orderBy: { sequence: "desc" },
+        take: 1,
+        select: { status: true, dueAt: true, analyzedAt: true },
+      },
+    },
+  });
+  if (!task || !isDocumentTaskType(task.type)) return;
+
+  const current = task.documentRevisions[0] ?? null;
+  const result = projectDocumentTask({
+    current: current
+      ? { status: current.status as DocumentStatus, dueAt: current.dueAt, analyzedAt: current.analyzedAt }
+      : null,
+    declaredProgress: task.documentTask?.declaredProgress ?? 0,
+    blocked: task.impediments.length > 0,
+  });
+
+  const nextForecast = result.forecastDate ?? task.forecastDate;
+  const change = buildDeadlineChange(task.forecastDate, nextForecast);
+  const stampStart = shouldStampActualStart(task.progress, result.progress, task.actualStartDate);
+
+  await db.milestone.update({
+    where: { id: task.id },
+    data: {
+      status: result.status,
+      progress: result.progress,
+      forecastDate: nextForecast,
+      actualDate: result.actualDate,
+      ...(task.plannedDate === null && nextForecast ? { plannedDate: nextForecast } : {}),
+      ...(stampStart ? { actualStartDate: new Date() } : {}),
+    },
+  });
+
+  if (change) {
+    await db.deadlineChange.create({
+      data: {
+        milestoneId: task.id,
+        fromDate: change.fromDate,
+        toDate: change.toDate,
+        reason: "Recalculado a partir do ciclo de revisão do documento.",
+      },
+    });
+  }
+
+  if (task.parentId) await recomputeRollup(task.parentId, db);
+}
+
+/**
+ * Cria a tarefa de um documento dentro de um Marco (pai obrigatório) e liga
+ * Document.taskId. Devolve o id da tarefa.
+ */
+export async function createDocumentTask(
+  input: { documentId: string; projectId: string; marcoId: string; assigneeId?: string | null },
+  db: Db = prisma,
+): Promise<{ error: string } | { id: string }> {
+  if (!input.marcoId) return { error: "Escolha o marco do documento." };
+  const [doc, marco] = await Promise.all([
+    db.document.findUnique({
+      where: { id: input.documentId },
+      select: { id: true, projectId: true, number: true, name: true, taskId: true, responsibleId: true },
+    }),
+    db.milestone.findUnique({
+      where: { id: input.marcoId },
+      select: { id: true, projectId: true, kind: true, parentId: true },
+    }),
+  ]);
+  if (!doc || doc.projectId !== input.projectId) return { error: "Documento não encontrado." };
+  if (doc.taskId) return { id: doc.taskId };
+  if (!marco) return { error: "Marco selecionado não encontrado." };
+  const error = validateParentLink({ projectId: input.projectId, kind: "TASK" }, marco);
+  if (error) return { error };
+
+  const created = await db.milestone.create({
+    data: {
+      projectId: input.projectId,
+      parentId: marco.id,
+      name: taskNameForDocument(doc),
+      kind: "TASK",
+      type: DOCUMENT_TASK_TYPE,
+      status: "NOT_STARTED",
+      assigneeId: input.assigneeId ?? doc.responsibleId ?? null,
+    },
+    select: { id: true },
+  });
+  await db.document.update({ where: { id: doc.id }, data: { taskId: created.id } });
+  await recomputeRollup(marco.id, db);
+  return { id: created.id };
+}
+
+/* ------------------------------------------------------------------------ */
+/* Migração do legado: pacote -> uma tarefa por documento                    */
+/* ------------------------------------------------------------------------ */
+
+export interface MigrationSummary {
+  organizations: number;
+  documentsToMigrate: number;
+  alreadyMigrated: number;
+  tasksCreated: number;
+  emptyPackagesRemoved: number;
+}
+
+/**
+ * Cria a tarefa de cada documento que ainda não tem uma, aponta as revisões
+ * para ela e remove os pacotes que ficaram sem revisões (eram só projeção).
+ * Sem `apply`, apenas conta (simulação). Idempotente.
+ *
+ * RODE PRIMEIRO NUM BRANCH DO NEON: produção e desenvolvimento compartilham o
+ * banco e a migração muda a estrutura de trabalho do projeto inteiro.
+ */
+export async function migrateDocumentsToTasks(
+  db: Db,
+  scope: { organizationId: string },
+  opts: { apply: boolean },
+): Promise<MigrationSummary> {
+  const docs = await db.document.findMany({
+    where: { project: { organizationId: scope.organizationId } },
+    select: {
+      id: true,
+      projectId: true,
+      number: true,
+      name: true,
+      taskId: true,
+      responsibleId: true,
+      revisions: {
+        select: {
+          id: true,
+          status: true,
+          sequence: true,
+          dueAt: true,
+          analyzedAt: true,
+          issuedAt: true,
+          createdAt: true,
+          milestone: { select: { parentId: true, type: true } },
+        },
+      },
+    },
+  });
+
+  const input: MigrationDocument[] = docs.map((d) => ({
+    id: d.id,
+    projectId: d.projectId,
+    number: d.number,
+    name: d.name,
+    taskId: d.taskId,
+    responsibleId: d.responsibleId,
+    revisions: d.revisions.map((r) => ({
+      id: r.id,
+      status: r.status as DocumentStatus,
+      sequence: r.sequence,
+      dueAt: r.dueAt,
+      analyzedAt: r.analyzedAt,
+      issuedAt: r.issuedAt,
+      createdAt: r.createdAt,
+      packageParentId: r.milestone && r.milestone.type === PACKAGE_TYPE ? r.milestone.parentId : null,
+    })),
+  }));
+
+  const plan = planDocumentTasks(input);
+  const summary: MigrationSummary = {
+    organizations: 1,
+    documentsToMigrate: plan.tasks.length,
+    alreadyMigrated: plan.alreadyMigrated,
+    tasksCreated: 0,
+    emptyPackagesRemoved: 0,
+  };
+  if (!opts.apply || plan.tasks.length === 0) return summary;
+
+  const legacyByProject = new Map<string, string>();
+  const parentsTouched = new Set<string>();
+  const packagesTouched = new Set<string>();
+
+  for (const t of plan.tasks) {
+    let parentId: string;
+    if (t.parentId === LEGACY_PARENT) {
+      let id = legacyByProject.get(t.projectId);
+      if (!id) {
+        const found = await db.milestone.findFirst({
+          where: { projectId: t.projectId, kind: "MILESTONE", name: LEGACY_MARCO_TITLE },
+          select: { id: true },
+        });
+        id =
+          found?.id ??
+          (
+            await db.milestone.create({
+              data: {
+                projectId: t.projectId,
+                name: LEGACY_MARCO_TITLE,
+                kind: "MILESTONE",
+                type: "Documentos",
+                status: "NOT_STARTED",
+              },
+              select: { id: true },
+            })
+          ).id;
+        legacyByProject.set(t.projectId, id);
+      }
+      parentId = id;
+    } else {
+      parentId = t.parentId;
+    }
+
+    const oldPackages = await db.documentRevision.findMany({
+      where: { id: { in: t.revisionIds }, milestoneId: { not: null } },
+      select: { milestoneId: true },
+    });
+    oldPackages.forEach((r) => r.milestoneId && packagesTouched.add(r.milestoneId));
+
+    const created = await db.milestone.create({
+      data: {
+        projectId: t.projectId,
+        parentId,
+        name: t.name,
+        kind: "TASK",
+        type: DOCUMENT_TASK_TYPE,
+        status: t.status,
+        progress: t.progress,
+        startDate: t.startDate,
+        actualStartDate: t.actualStartDate,
+        plannedDate: t.plannedDate,
+        forecastDate: t.forecastDate,
+        actualDate: t.actualDate,
+        assigneeId: t.assigneeId,
+      },
+      select: { id: true },
+    });
+    await db.document.update({ where: { id: t.documentId }, data: { taskId: created.id } });
+    await db.documentRevision.updateMany({
+      where: { id: { in: t.revisionIds } },
+      data: { milestoneId: created.id },
+    });
+    parentsTouched.add(parentId);
+    summary.tasksCreated += 1;
+  }
+
+  // Pacote sem revisões é só projeção vazia: sai (nunca remove pacote com revisão).
+  for (const id of packagesTouched) {
+    const pkg = await db.milestone.findUnique({
+      where: { id },
+      select: { type: true, parentId: true, _count: { select: { documentRevisions: true } } },
+    });
+    if (pkg && pkg.type === PACKAGE_TYPE && pkg._count.documentRevisions === 0) {
+      await db.milestone.delete({ where: { id } });
+      if (pkg.parentId) parentsTouched.add(pkg.parentId);
+      summary.emptyPackagesRemoved += 1;
+    }
+  }
+
+  for (const id of parentsTouched) await recomputeRollup(id, db);
+  return summary;
+}
