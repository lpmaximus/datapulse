@@ -0,0 +1,50 @@
+import { reviewDueDate } from "./business-days";
+
+/**
+ * Plano de preenchimento de `dueAt` para revisões abertas legadas (sem prazo).
+ * Módulo puro: recebe linhas planas e devolve o que gravar. A gravação fica
+ * em `scripts/backfill-due-dates.ts`, opt-in e com `--dry` por padrão.
+ *
+ * Regra (decisão de 21/09/2026): prazo = entrada + 5 dias úteis. A entrada é a
+ * data de envio (`issuedAt`); sem ela, usa-se o início da análise atual
+ * (`inReviewSince`). Revisão sem nenhuma das duas datas é reportada, não chutada.
+ */
+export type OpenRevisionRow = {
+  id: string;
+  status: string;
+  dueAt: Date | null;
+  issuedAt: Date | null;
+  inReviewSince: Date | null;
+};
+
+export type DueBackfillPlan = {
+  updates: { id: string; dueAt: Date; basis: "issuedAt" | "inReviewSince" }[];
+  skippedHasDue: number;
+  skippedNotOpen: number;
+  withoutBasis: string[];
+};
+
+export function planDueDateBackfill(
+  rows: ReadonlyArray<OpenRevisionRow>,
+  holidays: ReadonlyArray<Date | string> = [],
+): DueBackfillPlan {
+  const plan: DueBackfillPlan = { updates: [], skippedHasDue: 0, skippedNotOpen: 0, withoutBasis: [] };
+  for (const r of rows) {
+    if (r.status !== "IN_REVIEW") {
+      plan.skippedNotOpen += 1;
+      continue;
+    }
+    if (r.dueAt) {
+      plan.skippedHasDue += 1;
+      continue;
+    }
+    const basis = r.issuedAt ? "issuedAt" : r.inReviewSince ? "inReviewSince" : null;
+    if (!basis) {
+      plan.withoutBasis.push(r.id);
+      continue;
+    }
+    const from = (basis === "issuedAt" ? r.issuedAt : r.inReviewSince) as Date;
+    plan.updates.push({ id: r.id, dueAt: reviewDueDate(from, holidays), basis });
+  }
+  return plan;
+}
diff --git a/lib/inbox.ts b/lib/inbox.ts
new file mode 100644
index 0000000..11519c1
--- /dev/null
+++ b/lib/inbox.ts
@@ -0,0 +1,57 @@
+/**
+ * Caixa de entrada do avaliador (contratante): documentos e orçamentos
+ * aguardando avaliação, com o vencimento visível (contagem de dias, em destaque
+ * quando vence). É a fonte da verdade; o e-mail é só aviso.
+ *
+ * Módulo puro, testado em `test/inbox.test.mjs`.
+ */
+export interface InboxItem {
+  id: string;
+  kind: "DOCUMENT" | "BUDGET";
+  label: string;
+  dueAt: Date | null;
+  sentAt: Date | null;
+}
+
+export type DueTone = "overdue" | "today" | "soon" | "ok" | "none";
+
+export interface InboxRow extends InboxItem {
+  /** Dias até o vencimento (negativo = vencido); null sem prazo. */
+  daysLeft: number | null;
+  tone: DueTone;
+  dueLabel: string;
+}
+
+const DAY_MS = 86_400_000;
+
+/** Dia de calendário (UTC) — o prazo é uma data, sem hora. */
+function dayNumber(d: Date): number {
+  return Math.floor(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()) / DAY_MS);
+}
+
+export function dueInfo(dueAt: Date | null, today: Date): { daysLeft: number | null; tone: DueTone; label: string } {
+  if (!dueAt) return { daysLeft: null, tone: "none", label: "Sem prazo" };
+  const daysLeft = dayNumber(dueAt) - dayNumber(today);
+  if (daysLeft < 0) {
+    const n = -daysLeft;
+    return { daysLeft, tone: "overdue", label: n === 1 ? "Venceu há 1 dia" : `Venceu há ${n} dias` };
+  }
+  if (daysLeft === 0) return { daysLeft, tone: "today", label: "Vence hoje" };
+  if (daysLeft <= 2) return { daysLeft, tone: "soon", label: daysLeft === 1 ? "Vence amanhã" : "Vence em 2 dias" };
+  return { daysLeft, tone: "ok", label: `Vence em ${daysLeft} dias` };
+}
+
+/** Vencidos primeiro (mais atrasado no topo), depois por vencimento; sem prazo por último. */
+export function buildInbox(items: ReadonlyArray<InboxItem>, today: Date): InboxRow[] {
+  return items
+    .map((it) => {
+      const info = dueInfo(it.dueAt, today);
+      return { ...it, daysLeft: info.daysLeft, tone: info.tone, dueLabel: info.label };
+    })
+    .sort((a, b) => {
+      if (a.daysLeft === null && b.daysLeft === null) return (a.sentAt?.getTime() ?? 0) - (b.sentAt?.getTime() ?? 0);
+      if (a.daysLeft === null) return 1;
+      if (b.daysLeft === null) return -1;
+      return a.daysLeft - b.daysLeft;
+    });
+}
diff --git a/lib/ld.ts b/lib/ld.ts
new file mode 100644
index 0000000..9a49337
--- /dev/null
+++ b/lib/ld.ts
@@ -0,0 +1,228 @@
+import { a1Equivalent, normalizeFormat, type A1Factors, DEFAULT_A1_FACTORS } from "./a1";
+
+/**
+ * LD — Lista de Documentos enviada pelo contratante junto com a demanda.
+ * Cada linha vira um documento da demanda. Módulo puro: recebe linhas já lidas
+ * da planilha (cabeçalho -> valor) e devolve linhas normalizadas + erros, e
+ * compara uma LD nova com os documentos já cadastrados (casando pelo número do
+ * cliente). Testado em `test/ld.test.mjs`.
+ *
+ * Colunas reconhecidas (por sinônimo, sem acento/caixa): número do cliente,
+ * número do projetista, descrição, disciplina, formato, folhas, prazo. Cada
+ * contratante pode usar nomes diferentes; os sinônimos abaixo são o padrão e
+ * `columnMap` permite sobrescrever por contratante.
+ */
+export type LdColumn =
+  | "clientNumber"
+  | "designerNumber"
+  | "name"
+  | "discipline"
+  | "format"
+  | "sheets"
+  | "dueDate";
+
+export const LD_COLUMN_LABEL: Record<LdColumn, string> = {
+  clientNumber: "Número do cliente",
+  designerNumber: "Número do projetista",
+  name: "Descrição",
+  discipline: "Disciplina",
+  format: "Formato",
+  sheets: "Folhas",
+  dueDate: "Prazo",
+};
+
+export const LD_DEFAULT_ALIASES: Record<LdColumn, string[]> = {
+  clientNumber: ["numero do cliente", "n do cliente", "num cliente", "numero cliente", "codigo cliente", "numero do documento", "num doc", "documento"],
+  designerNumber: ["numero do projetista", "n do projetista", "num projetista", "numero projetista", "codigo projetista"],
+  name: ["descricao", "titulo", "nome", "nome do documento"],
+  discipline: ["disciplina", "area"],
+  format: ["formato", "folha formato", "tamanho"],
+  sheets: ["folhas", "numero de folhas", "n de folhas", "qtd folhas", "paginas"],
+  dueDate: ["prazo", "data prazo", "data limite", "vencimento", "data"],
+};
+
+export function normalizeHeader(h: unknown): string {
+  return String(h ?? "")
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .toLowerCase()
+    .replace(/[º°.]/g, "")
+    .replace(/[^a-z0-9]+/g, " ")
+    .trim();
+}
+
+/** Chave de casamento do número do cliente: sem espaços extras, caixa alta. */
+export function normalizeNumber(v: unknown): string {
+  return String(v ?? "").trim().replace(/\s+/g, " ").toUpperCase();
+}
+
+export interface LdRow {
+  /** Linha da planilha (1 = primeira linha de dados), para mensagens de erro. */
+  line: number;
+  clientNumber: string;
+  designerNumber: string | null;
+  name: string;
+  discipline: string | null;
+  format: string | null;
+  sheets: number | null;
+  a1Equivalent: number | null;
+  dueDate: Date | null;
+}
+
+export interface LdIssue {
+  line: number;
+  message: string;
+}
+
+export interface LdParseResult {
+  rows: LdRow[];
+  issues: LdIssue[];
+  /** Colunas obrigatórias que não foram encontradas no cabeçalho. */
+  missingColumns: LdColumn[];
+}
+
+const REQUIRED: LdColumn[] = ["clientNumber", "name"];
+
+function parseDate(v: unknown): Date | null {
+  if (v instanceof Date && !Number.isNaN(v.getTime())) {
+    return new Date(Date.UTC(v.getUTCFullYear(), v.getUTCMonth(), v.getUTCDate()));
+  }
+  const s = String(v ?? "").trim();
+  if (!s) return null;
+  let m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s);
+  if (m) return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
+  m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
+  if (m) return new Date(Date.UTC(+m[3], +m[2] - 1, +m[1]));
+  return null;
+}
+
+export function parseLd(
+  input: ReadonlyArray<Record<string, unknown>>,
+  opts: { factors?: A1Factors; columnMap?: Partial<Record<LdColumn, string>> } = {},
+): LdParseResult {
+  const factors = opts.factors ?? DEFAULT_A1_FACTORS;
+  const headers = input.length ? Object.keys(input[0]) : [];
+  const byNorm = new Map(headers.map((h) => [normalizeHeader(h), h]));
+
+  const colKey: Partial<Record<LdColumn, string>> = {};
+  (Object.keys(LD_DEFAULT_ALIASES) as LdColumn[]).forEach((col) => {
+    const override = opts.columnMap?.[col];
+    if (override && byNorm.has(normalizeHeader(override))) {
+      colKey[col] = byNorm.get(normalizeHeader(override));
+      return;
+    }
+    for (const alias of LD_DEFAULT_ALIASES[col]) {
+      if (byNorm.has(alias)) {
+        colKey[col] = byNorm.get(alias);
+        return;
+      }
+    }
+  });
+
+  const missingColumns = REQUIRED.filter((c) => !colKey[c]);
+  const result: LdParseResult = { rows: [], issues: [], missingColumns };
+  if (missingColumns.length > 0) return result;
+
+  const seen = new Map<string, number>();
+  input.forEach((raw, i) => {
+    const line = i + 1;
+    const get = (c: LdColumn) => (colKey[c] ? raw[colKey[c] as string] : undefined);
+
+    const clientNumber = normalizeNumber(get("clientNumber"));
+    const name = String(get("name") ?? "").trim();
+    if (!clientNumber && !name) return; // linha em branco
+    if (!clientNumber) {
+      result.issues.push({ line, message: "Linha sem número do cliente." });
+      return;
+    }
+    if (!name) {
+      result.issues.push({ line, message: `${clientNumber}: linha sem descrição.` });
+      return;
+    }
+    if (seen.has(clientNumber)) {
+      result.issues.push({ line, message: `${clientNumber}: repetido (já aparece na linha ${seen.get(clientNumber)}).` });
+      return;
+    }
+    seen.set(clientNumber, line);
+
+    const format = normalizeFormat(get("format"));
+    const sheetsRaw = get("sheets");
+    const sheetsNum = sheetsRaw === undefined || sheetsRaw === "" ? null : Number(String(sheetsRaw).replace(",", "."));
+    const sheets = sheetsNum !== null && Number.isInteger(sheetsNum) && sheetsNum >= 1 ? sheetsNum : null;
+    if (sheetsNum !== null && sheets === null) {
+      result.issues.push({ line, message: `${clientNumber}: folhas inválidas (${String(sheetsRaw)}).` });
+    }
+    const a1 = format && sheets !== null ? a1Equivalent(format, sheets, factors) : null;
+    if (format && sheets !== null && a1 === null) {
+      result.issues.push({ line, message: `${clientNumber}: formato "${format}" não está na tabela de fatores.` });
+    }
+
+    const designer = String(get("designerNumber") ?? "").trim();
+    const discipline = String(get("discipline") ?? "").trim();
+    result.rows.push({
+      line,
+      clientNumber,
+      designerNumber: designer || null,
+      name,
+      discipline: discipline || null,
+      format,
+      sheets,
+      a1Equivalent: a1,
+      dueDate: parseDate(get("dueDate")),
+    });
+  });
+  return result;
+}
+
+/* ------------------------------ Revisão da LD ----------------------------- */
+
+export interface ExistingLdDocument {
+  id: string;
+  clientNumber: string;
+  name: string;
+  format: string | null;
+  sheets: number | null;
+  cancelled: boolean;
+}
+
+export interface LdDiff {
+  /** Documentos novos: entram na demanda (e geram orçamento complementar). */
+  create: LdRow[];
+  /** Mudaram descrição, formato ou folhas: atualizar (pode mudar o orçamento). */
+  update: { id: string; row: LdRow; changed: ("name" | "format" | "sheets")[] }[];
+  /** Saíram da lista: cancelar com motivo "LD revisada". */
+  cancel: string[];
+  /** Estavam cancelados e voltaram na lista. */
+  reactivate: string[];
+  unchanged: number;
+}
+
+export const LD_REVISED_REASON = "LD revisada";
+
+export function diffLd(existing: ReadonlyArray<ExistingLdDocument>, incoming: ReadonlyArray<LdRow>): LdDiff {
+  const byNumber = new Map(existing.map((d) => [normalizeNumber(d.clientNumber), d]));
+  const incomingNumbers = new Set(incoming.map((r) => r.clientNumber));
+  const diff: LdDiff = { create: [], update: [], cancel: [], reactivate: [], unchanged: 0 };
+
+  for (const row of incoming) {
+    const doc = byNumber.get(row.clientNumber);
+    if (!doc) {
+      diff.create.push(row);
+      continue;
+    }
+    if (doc.cancelled) {
+      diff.reactivate.push(doc.id);
+      continue;
+    }
+    const changed: ("name" | "format" | "sheets")[] = [];
+    if (doc.name.trim() !== row.name.trim()) changed.push("name");
+    if (row.format !== null && (doc.format ?? null) !== row.format) changed.push("format");
+    if (row.sheets !== null && (doc.sheets ?? null) !== row.sheets) changed.push("sheets");
+    if (changed.length) diff.update.push({ id: doc.id, row, changed });
+    else diff.unchanged += 1;
+  }
+  for (const doc of existing) {
+    if (!doc.cancelled && !incomingNumbers.has(normalizeNumber(doc.clientNumber))) diff.cancel.push(doc.id);
+  }
+  return diff;
+}
diff --git a/lib/mail.ts b/lib/mail.ts
new file mode 100644
index 0000000..a2711ee
--- /dev/null
+++ b/lib/mail.ts
@@ -0,0 +1,128 @@
+/**
+ * E-mail transacional (decisão de 15/10/2026): o e-mail é SÓ um aviso — projeto,
+ * documento ou orçamento, revisão, quem enviou e o botão "Abrir no DataPulse".
+ * Sem PDF e sem comentário: ninguém decide por e-mail. A caixa de entrada do
+ * sistema é a fonte da verdade; se o e-mail falhar, a pendência continua lá.
+ *
+ * O envio fica atrás de uma interface (`MailTransport`) para o provedor ser
+ * escolhido depois sem mexer nas regras. Sem credencial configurada, o
+ * transporte padrão só registra em log (nada é enviado).
+ *
+ * Módulo puro (nenhum acesso a rede aqui), testado em `test/mail.test.mjs`.
+ */
+export interface MailMessage {
+  to: string[];
+  subject: string;
+  text: string;
+  html: string;
+}
+
+export interface MailTransport {
+  readonly name: string;
+  send(message: MailMessage): Promise<{ ok: boolean; error?: string }>;
+}
+
+/** Transporte padrão: não envia, só registra. Usado até haver credencial. */
+export class LogOnlyTransport implements MailTransport {
+  readonly name = "log-only";
+  constructor(private readonly log: (line: string) => void = (l) => console.log(l)) {}
+  async send(message: MailMessage) {
+    this.log(`[mail:${this.name}] para=${message.to.join(",")} assunto="${message.subject}"`);
+    return { ok: true };
+  }
+}
+
+export type NoticeKind = "DOCUMENT_SENT" | "BUDGET_SENT" | "DOCUMENT_RETURNED" | "BUDGET_RETURNED" | "REMINDER";
+
+export interface NoticeInput {
+  kind: NoticeKind;
+  projectName: string;
+  /** "PE-ELE-001 — Diagrama unifilar" ou "Orçamento 2". */
+  itemLabel: string;
+  /** Revisão ("Rev. B") quando se aplica. */
+  revision?: string | null;
+  senderName: string;
+  /** Link absoluto para abrir o item no sistema. */
+  url: string;
+  /** Vencimento da avaliação, se houver. */
+  dueDate?: Date | null;
+}
+
+const KIND_LABEL: Record<NoticeKind, string> = {
+  DOCUMENT_SENT: "Documento enviado para avaliação",
+  BUDGET_SENT: "Orçamento enviado para avaliação",
+  DOCUMENT_RETURNED: "Documento devolvido",
+  BUDGET_RETURNED: "Orçamento devolvido",
+  REMINDER: "Lembrete: avaliação pendente",
+};
+
+function esc(s: string): string {
+  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
+}
+
+function fmtDate(d: Date): string {
+  const dd = String(d.getUTCDate()).padStart(2, "0");
+  const mm = String(d.getUTCMonth() + 1).padStart(2, "0");
+  return `${dd}/${mm}/${d.getUTCFullYear()}`;
+}
+
+/** URL só pode ser http(s) — nunca montar link a partir de texto arbitrário. */
+export function isSafeUrl(url: string): boolean {
+  try {
+    const u = new URL(url);
+    return u.protocol === "https:" || u.protocol === "http:";
+  } catch {
+    return false;
+  }
+}
+
+export function buildNotice(to: string[], input: NoticeInput): MailMessage | null {
+  const recipients = [...new Set(to.map((t) => t.trim().toLowerCase()).filter((t) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(t)))];
+  if (recipients.length === 0 || !isSafeUrl(input.url)) return null;
+
+  const rev = input.revision ? ` (${input.revision})` : "";
+  const subject = `${KIND_LABEL[input.kind]} — ${input.itemLabel}${rev}`;
+  const due = input.dueDate ? `Vencimento: ${fmtDate(input.dueDate)}.` : "";
+
+  const text = [
+    KIND_LABEL[input.kind],
+    `Projeto: ${input.projectName}`,
+    `Item: ${input.itemLabel}${rev}`,
+    `Enviado por: ${input.senderName}`,
+    due,
+    "",
+    `Abrir no DataPulse: ${input.url}`,
+    "",
+    "Este e-mail é apenas um aviso. A decisão é feita dentro do DataPulse.",
+  ]
+    .filter((l, i, a) => l !== "" || (a[i - 1] ?? "") !== "")
+    .join("\n");
+
+  const html =
+    `<p><strong>${esc(KIND_LABEL[input.kind])}</strong></p>` +
+    `<p>Projeto: ${esc(input.projectName)}<br>Item: ${esc(input.itemLabel + rev)}<br>Enviado por: ${esc(input.senderName)}` +
+    (due ? `<br>${esc(due)}` : "") +
+    `</p><p><a href="${esc(input.url)}">Abrir no DataPulse</a></p>` +
+    `<p style="color:#666">Este e-mail é apenas um aviso. A decisão é feita dentro do DataPulse.</p>`;
+
+  return { to: recipients, subject, text, html };
+}
+
+/**
+ * Envia sem nunca quebrar o fluxo: falha de e-mail vira resultado, não exceção
+ * (a pendência continua na caixa de entrada).
+ */
+export async function sendNotice(
+  transport: MailTransport,
+  to: string[],
+  input: NoticeInput,
+): Promise<{ sent: boolean; reason?: string }> {
+  const message = buildNotice(to, input);
+  if (!message) return { sent: false, reason: "Sem destinatário válido ou link inválido." };
+  try {
+    const r = await transport.send(message);
+    return r.ok ? { sent: true } : { sent: false, reason: r.error ?? "Falha no envio." };
+  } catch (e) {
+    return { sent: false, reason: e instanceof Error ? e.message : "Falha no envio." };
+  }
+}
diff --git a/lib/review-return.ts b/lib/review-return.ts
new file mode 100644
index 0000000..e6fd062
--- /dev/null
+++ b/lib/review-return.ts
@@ -0,0 +1,80 @@
+/**
+ * Devolução da revisão pelo contratante (decisão de 15/10/2026): a marcação de
+ * comentários é feita SÓ no PDF, no programa que o contratante já usa; ele
+ * anexa o PDF comentado e/ou escreve uma nota. O sistema não edita o PDF e não
+ * cadastra comentário item por item.
+ *
+ * Regras:
+ *  - Comentar exige o PDF comentado OU um texto.
+ *  - Aprovar não exige nada.
+ *  - Cancelar exige motivo (documento cancelado sai de todos os cálculos).
+ *  - A projetista não aprova o próprio trabalho.
+ *
+ * Módulo puro, testado em `test/review-return.test.mjs`.
+ */
+export type ReturnDecision = "APPROVE" | "COMMENT" | "CANCEL";
+
+export const DECISION_LABEL: Record<ReturnDecision, string> = {
+  APPROVE: "Aprovar",
+  COMMENT: "Comentar",
+  CANCEL: "Cancelar",
+};
+
+/** Só PDF no sistema; DWG segue por e-mail depois da aprovação. */
+export const COMMENT_FILE_CONTENT_TYPE = "application/pdf";
+/** Padrão adotado (ajustável): 25 MB por PDF comentado e até 5 versões por documento. */
+export const MAX_COMMENT_FILE_BYTES = 25 * 1024 * 1024;
+export const MAX_COMMENT_FILES_PER_DOCUMENT = 5;
+
+export type ReturnInput = {
+  decision: ReturnDecision;
+  text?: string | null;
+  hasFile?: boolean;
+};
+
+export type ValidationResult = { ok: true } | { ok: false; error: string };
+
+export function validateReturn(input: ReturnInput): ValidationResult {
+  const text = (input.text ?? "").trim();
+  switch (input.decision) {
+    case "APPROVE":
+      return { ok: true };
+    case "COMMENT":
+      if (!text && !input.hasFile) {
+        return { ok: false, error: "Para comentar, anexe o PDF comentado ou escreva uma nota." };
+      }
+      return { ok: true };
+    case "CANCEL":
+      if (!text) return { ok: false, error: "Informe o motivo do cancelamento." };
+      return { ok: true };
+    default:
+      return { ok: false, error: "Decisão inválida." };
+  }
+}
+
+/** A projetista (emissora) não decide sobre o que ela mesma emitiu. */
+export function canDecideOnRevision(actor: { id: string }, issuerId: string | null | undefined): boolean {
+  return !issuerId || actor.id !== issuerId;
+}
+
+export function validateCommentFile(file: {
+  contentType: string;
+  sizeBytes: number;
+  existingCount: number;
+}): ValidationResult {
+  const type = file.contentType.split(";")[0].trim().toLowerCase();
+  if (type !== COMMENT_FILE_CONTENT_TYPE) return { ok: false, error: "O PDF comentado deve estar em formato PDF." };
+  if (!(file.sizeBytes > 0)) return { ok: false, error: "Arquivo vazio." };
+  if (file.sizeBytes > MAX_COMMENT_FILE_BYTES) {
+    return { ok: false, error: "O PDF comentado passa de 25 MB." };
+  }
+  if (file.existingCount >= MAX_COMMENT_FILES_PER_DOCUMENT) {
+    return { ok: false, error: "Limite de 5 PDFs comentados por documento atingido." };
+  }
+  return { ok: true };
+}
+
+/** Caminho do blob do PDF comentado (sempre por projeto, nome seguro). */
+export function commentBlobPrefix(projectId: string): string {
+  return `projetos/${projectId}/comentarios/`;
+}
diff --git a/lib/server/decision-service.ts b/lib/server/decision-service.ts
new file mode 100644
index 0000000..a102f76
--- /dev/null
+++ b/lib/server/decision-service.ts
@@ -0,0 +1,104 @@
+import { prisma } from "@/lib/prisma";
+import { projectVisibility } from "@/lib/visibility";
+import { leafTasks } from "@/lib/tasks";
+import type { DecisionFacts, TaskFact } from "@/lib/decision";
+
+/**
+ * Lê (somente leitura) o último snapshot do DRI de um projeto e monta os
+ * fatos que o Decision OS explica. Nada é recalculado aqui: o DRI continua
+ * sendo o único dono do cálculo (cron diário + ações de documento).
+ *
+ * Respeita a visibilidade por papel: projeto fora da visão do usuário = null.
+ */
+type Component = { value?: number };
+
+function flattenComponents(breakdown: unknown): Record<string, number> {
+  const out: Record<string, number> = {};
+  if (!breakdown || typeof breakdown !== "object") return out;
+  const b = breakdown as { human?: Record<string, Component>; systemic?: Record<string, Component> };
+  for (const group of [b.human, b.systemic]) {
+    if (!group) continue;
+    for (const [key, c] of Object.entries(group)) {
+      if (c && typeof c.value === "number") out[key] = c.value;
+    }
+  }
+  return out;
+}
+
+function num(v: unknown): number | null {
+  return typeof v === "number" && Number.isFinite(v) ? v : null;
+}
+
+export async function loadDecisionFacts(
+  projectId: string,
+  user: { id: string; role: string; organizationId: string },
+  now: Date = new Date(),
+): Promise<DecisionFacts | null> {
+  const project = await prisma.project.findFirst({
+    where: { id: projectId, ...projectVisibility(user) },
+    select: { id: true, name: true },
+  });
+  if (!project) return null;
+
+  const weekAgo = new Date(now.getTime() - 7 * 86_400_000);
+  const [projectNow, projectBefore, milestones] = await Promise.all([
+    prisma.dRIScore.findFirst({
+      where: { projectId, milestoneId: null },
+      orderBy: { calculatedAt: "desc" },
+      select: { score: true },
+    }),
+    prisma.dRIScore.findFirst({
+      where: { projectId, milestoneId: null, calculatedAt: { lte: weekAgo } },
+      orderBy: { calculatedAt: "desc" },
+      select: { score: true },
+    }),
+    prisma.milestone.findMany({
+      where: { projectId, status: { notIn: ["CANCELLED", "DONE"] } },
+      select: {
+        id: true,
+        name: true,
+        parentId: true,
+        driScores: {
+          orderBy: { calculatedAt: "desc" },
+          take: 1,
+          select: { score: true, humanScore: true, systemicScore: true, breakdown: true },
+        },
+      },
+    }),
+  ]);
+
+  const leafIds = new Set(
+    leafTasks(milestones.map((m) => ({ id: m.id, parentId: m.parentId }))).map((m) => m.id),
+  );
+
+  const tasks: TaskFact[] = [];
+  let confidence: number | null = null;
+  let topScore = -1;
+  for (const m of milestones) {
+    const snap = m.driScores[0];
+    if (!snap || !leafIds.has(m.id)) continue;
+    const b = snap.breakdown as Record<string, unknown> | null;
+    tasks.push({
+      id: m.id,
+      name: m.name,
+      score: snap.score,
+      economicExposure: num(b?.economicExposure),
+      humanScore: snap.humanScore,
+      systemicScore: snap.systemicScore,
+      components: flattenComponents(b),
+      humanSignalCount: num(b?.humanSignalCount) ?? 0,
+    });
+    if (snap.score > topScore) {
+      topScore = snap.score;
+      confidence = num(b?.confidence);
+    }
+  }
+
+  return {
+    projectName: project.name,
+    projectScore: projectNow?.score ?? 0,
+    previousScore: projectBefore?.score ?? null,
+    confidence,
+    tasks,
+  };
+}
