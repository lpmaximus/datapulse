new file mode 100644
index 0000000..95f9a2c
--- /dev/null
+++ b/lib/client-progress.ts
@@ -0,0 +1,74 @@
+/**
+ * Avanço mostrado ao contratante ("Seu projeto está x% concluído").
+ *
+ *   avanço = Σ (peso × avanço da tarefa) ÷ Σ pesos
+ *
+ * O peso é o A1 equivalente (tamanho, não esforço), o mesmo do orçamento — uma
+ * média simples distorceria (um A1 de 10 folhas pesa mais que um A4 de 1).
+ * Mostra DOIS números para não enganar o cliente:
+ *   - Elaboração: o que a projetista declara;
+ *   - Aprovado: parte do peso já aprovada pelo contratante.
+ * Documento em 100% de elaboração ainda não é documento aprovado.
+ *
+ * Cancelado sai do cálculo. Item fora de escopo (documento novo de LD revisada
+ * cujo orçamento complementar ainda não foi aprovado) também sai, e a tela deve
+ * deixar uma nota. Módulo puro, testado em `test/client-progress.test.mjs`.
+ */
+export interface ProgressItem {
+  /** A1 equivalente (ou peso equivalente da atividade). */
+  weight: number;
+  /** Avanço de elaboração declarado, 0–100. */
+  progress: number;
+  status: string;
+  /** Aprovado pelo contratante. */
+  approved: boolean;
+  /** Dentro do escopo já aprovado em orçamento. Padrão: true. */
+  inScope?: boolean;
+}
+
+export interface ClientProgress {
+  elaboration: number | null;
+  approved: number | null;
+  totalWeight: number;
+  /** Itens fora do escopo aprovado (para a nota na tela). */
+  pendingScopeItems: number;
+}
+
+const round1 = (n: number) => Math.round(n * 10) / 10;
+
+export function clientProgress(items: ReadonlyArray<ProgressItem>): ClientProgress {
+  let total = 0;
+  let elab = 0;
+  let appr = 0;
+  let pending = 0;
+  for (const it of items) {
+    if (it.status === "CANCELLED") continue;
+    if (it.inScope === false) {
+      pending += 1;
+      continue;
+    }
+    const w = Number.isFinite(it.weight) && it.weight > 0 ? it.weight : 0;
+    if (w === 0) continue;
+    const p = Math.min(100, Math.max(0, Number.isFinite(it.progress) ? it.progress : 0));
+    total += w;
+    elab += w * p;
+    appr += w * (it.approved ? 100 : 0);
+  }
+  if (total === 0) return { elaboration: null, approved: null, totalWeight: 0, pendingScopeItems: pending };
+  return {
+    elaboration: round1(elab / total),
+    approved: round1(appr / total),
+    totalWeight: Math.round(total * 1000) / 1000,
+    pendingScopeItems: pending,
+  };
+}
+
+/** Prazo de entrega exibido ao cliente. Cancelado e sem data ficam de fora. */
+export function clientDueDate(
+  items: ReadonlyArray<{ status: string; dueDate: Date | null }>,
+): Date | null {
+  const dates = items
+    .filter((i) => i.status !== "CANCELLED" && i.dueDate)
+    .map((i) => (i.dueDate as Date).getTime());
+  return dates.length ? new Date(Math.max(...dates)) : null;
+}
