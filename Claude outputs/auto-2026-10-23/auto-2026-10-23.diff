+
+import { computePaceComponent, rankByExposure, DRI_CONFIG } from "../lib/dri.ts";
+import { taskEconomicImpact } from "../lib/a1.ts";
+
+test("ritmo: sem início ou prazo válidos, não existe", () => {
+  assert.equal(computePaceComponent(undefined, NOW), null);
+  assert.equal(computePaceComponent({ startDate: null, dueDate: daysAhead(10), progress: 0 }, NOW), null);
+  assert.equal(computePaceComponent({ startDate: daysAhead(5), dueDate: daysAhead(2), progress: 0 }, NOW), null);
+});
+
+test("ritmo: avanço em dia não pontua; defasagem de 50 p.p. satura", () => {
+  // metade do caminho: início há 10 dias, prazo em 10 dias => esperado 50%
+  const onTrack = computePaceComponent({ startDate: daysAgo(10), dueDate: daysAhead(10), progress: 50 }, NOW);
+  assert.equal(onTrack.value, 0);
+  assert.equal(onTrack.weight, DRI_CONFIG.paceWeight);
+  const slightly = computePaceComponent({ startDate: daysAgo(10), dueDate: daysAhead(10), progress: 25 }, NOW);
+  assert.ok(Math.abs(slightly.value - 50) < 0.01); // 25 p.p. de defasagem => 50
+  const saturated = computePaceComponent({ startDate: daysAgo(10), dueDate: daysAhead(10), progress: 0 }, NOW);
+  assert.equal(saturated.value, 100);
+  const ahead = computePaceComponent({ startDate: daysAgo(10), dueDate: daysAhead(10), progress: 90 }, NOW);
+  assert.equal(ahead.value, 0);
+});
+
+test("ritmo: antes do início nada é esperado", () => {
+  const c = computePaceComponent({ startDate: daysAhead(5), dueDate: daysAhead(15), progress: 0 }, NOW);
+  assert.equal(c.value, 0);
+});
+
+test("ritmo entra na Camada 1 do marco e avisa antes do prazo vencer", () => {
+  const base = {
+    id: "m", name: "Doc", criticality: "MEDIUM", economicImpact: 10000,
+    plannedDate: daysAhead(10), forecastDate: daysAhead(10), actualDate: null,
+    humanSignals: [], systemicSignals: [],
+  };
+  const noPace = computeMilestoneDRI(base, NOW);
+  const withPace = computeMilestoneDRI(
+    { ...base, pace: { startDate: daysAgo(10), dueDate: daysAhead(10), progress: 0 } },
+    NOW,
+  );
+  assert.ok(withPace.breakdown.systemic.pace);
+  assert.ok(withPace.score > noPace.score);
+  assert.equal(withPace.breakdown.formulaVersion, "mvp-3");
+});
+
+test("exposição econômica: score ÷ 100 × valor; A1 grande destrava antes de A4", () => {
+  const mk = (id, score, impact) => ({ id, score, economicExposure: impact == null ? null : (score / 100) * impact });
+  const big = mk("a1-grande", 60, 10000); // 6000
+  const small = mk("a4", 60, 125); // 75
+  const noValue = mk("sem-valor", 90, null);
+  const ranked = rankByExposure([small, noValue, big]);
+  assert.deepEqual(ranked.map((r) => r.id), ["sem-valor", "a1-grande", "a4"]);
+  // empate de exposição cai no score e depois na ordem original
+  const t1 = { id: "x", score: 50, economicExposure: 100 };
+  const t2 = { id: "y", score: 70, economicExposure: 100 };
+  assert.deepEqual(rankByExposure([t1, t2]).map((r) => r.id), ["y", "x"]);
+});
+
+test("marco soma a exposição das filhas e mantém o pior score", () => {
+  const agg = aggregateGroupDRI([
+    { name: "a", score: 40, economicExposure: 100 },
+    { name: "b", score: 80, economicExposure: 50.555 },
+    { name: "c", score: 10 },
+  ]);
+  assert.equal(agg.score, 80);
+  assert.equal(agg.dominantChild, "b");
+  assert.equal(agg.economicExposure, 150.56);
+  assert.equal(aggregateGroupDRI([{ name: "z", score: 1 }]).economicExposure, null);
+});
+
+test("impacto econômico automático: digitado vence; senão A1 × valor", () => {
+  assert.equal(taskEconomicImpact({ explicit: 500, a1Equivalent: 2, a1UnitValue: 1000 }), 500);
+  assert.equal(taskEconomicImpact({ a1Equivalent: 2, a1UnitValue: 1000 }), 2000);
+  assert.equal(taskEconomicImpact({ a1Equivalent: 2, a1UnitValue: null }), null);
+  assert.equal(taskEconomicImpact({}), null);
 });
